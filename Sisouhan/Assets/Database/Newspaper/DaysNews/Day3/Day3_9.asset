  <ApprovedText>k__BackingField: "\uACF5\uAC1C\uC801\uC73C\uB85C \uD655\uC778 \uAC00\uB2A5\uD55C \uC9C0\uC5ED \uC18C\uC2DD\uC744 \uC815\uD655\uD558\uAC8C \uC804\uB2EC\uD574 \uC2E0\uB8B0\uB3C4\uAC00 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uACF5\uACF5 \uC758\uB8CC\uC11C\uBE44\uC2A4 \uD655\uB300\uC5D0 \uB300\uD55C \uAE0D\uC815\uC801\uC778 \uBC18\uC751\uC73C\uB85C \uD601\uBA85\uB3C4\uB294 \uC870\uAE08 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
