  <HeadLine>k__BackingField: "\uC2DC\uCCAD \uD55C \uB07C 120\uB9CC \uC6D0 \uC9C0\uCD9C\uB42C\uB2E4"
  <Text>k__BackingField: "XX\uC2DC\uAC00 \uACF5\uAC1C\uD55C \uC5C5\uBB34\uCD94\uC9C4\uBE44 \uB0B4\uC5ED\uC5D0 \uB530\uB974\uBA74 \uAC04\uBD80\uAE09 \uACF5\uBB34\uC6D0\uB4E4\uC774 \uCC38\uC11D\uD55C \uD55C \uCC28\uB840\uC758 \uC800\uB141 \uC2DD\uC0AC\uC5D0 \uC57D 120\uB9CC \uC6D0\uC774 \uC9C0\uCD9C\uB41C \uAC83\uC73C\uB85C \uB098\uD0C0\uB0AC\uC2B5\uB2C8\uB2E4. \uC2DC\uCCAD\uC740 \uCC38\uC11D \uC778\uC6D0\uACFC \uACF5\uC2DD \uC77C\uC815 \uB4F1\uC744 \uACE0\uB824\uD558\uBA74 \uADDC\uC815\uC0C1 \uBB38\uC81C\uAC00 \uC5C6\uB2E4\uACE0 \uD574\uBA85\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 6
  - <Effect>k__BackingField: 1
