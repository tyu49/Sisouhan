  <ApprovedText>k__BackingField: "\uB204\uAD6C\uB098 \uD655\uC778\uD560 \uC218 \uC788\uB294 \uACF5\uAC1C \uC790\uB8CC\uB97C \uD1A0\uB300\uB85C \uACF5\uACF5\uAE30\uAD00\uC758 \uC9C0\uCD9C\uC744 \uBE44\uD310\uD558\uBA74\uC11C \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uB9CC\uC740 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uD5E4\uB4DC\uB77C\uC778\uC758 \uB208\uC5D0 \uB744\uB294 \uC624\uD0C8\uC790\uB85C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
