  <ManagingID>k__BackingField: day_3_1
  <AppearingDay>k__BackingField: 3
  <HeadLine>k__BackingField: "\uB4F1\uB85D\uAE08 \uAC71\uC815 \uB35C\uC5B4\uC9C0\uB098, \uC815\uBD80 \uAD6D\uB9BD\uB300 \uC9C0\uC6D0 \uB300\uC0C1 \uB300\uD3ED \uD655\uB300"
  <Text>k__BackingField: "\uAD50\uC721\uBD80\uB294 \uB0B4\uB144\uB3C4 \uACE0\uB4F1\uAD50\uC721 \uC608\uC0B0\uC744 \uD655\uB300\uD558\uACE0 \uAD6D\uB9BD\uB300\uD559\uAD50 \uB4F1\uB85D\uAE08 \uC9C0\uC6D0 \uB300\uC0C1\uC744 \uAE30\uC874\uBCF4\uB2E4 \uB298\uB9AC\uACA0\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uAD6C\uCCB4\uC801\uC778 \uC9C0\uC6D0 \uAE30\uC900\uC740 \uCD94\uD6C4 \uACF5\uAC1C\uB420 \uC608\uC815\uC774\uBA70 \uAD50\uC721\uBD80\uB294 \uCCAD\uB144\uCE35\uC758 \uAD50\uC721\uBE44 \uBD80\uB2F4\uC744 \uB0AE\uCD94\uAE30 \uC704\uD55C \uC870\uCE58\uB77C\uACE0 \uC124\uBA85\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -8
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uC815\uBD80\uAC00 \uACF5\uAC1C\uD55C \uC815\uCC45\uC744 \uC815\uD655\uD788 \uC804\uB2EC\uD558\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uAC00 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uD559\uC0DD\uACFC \uD559\uBD80\uBAA8 \uC0AC\uC774\uC5D0\uC11C \uC815\uCC45\uC5D0 \uB300\uD55C \uAE0D\uC815\uC801\uC778 \uBC18\uC751\uC774 \uB098\uD0C0\uB098\uBA70 \uD601\uBA85\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
