  <ManagingID>k__BackingField: day_3_6
  <AppearingDay>k__BackingField: 3
  <HeadLine>k__BackingField: "\uD658\uACBD\uBD80 \"XX\uAC15 \uBB38\uC81C\uC5C6\uB2E4\" \uBC1C\uD45C"
  <Text>k__BackingField: "\uD658\uACBD\uBD80\uAC00 XX\uAC15 \uC778\uADFC \uC0B0\uC5C5\uB2E8\uC9C0\uB97C \uC870\uC0AC\uD55C \uACB0\uACFC \uBAA8\uB4E0 \uC5C5\uCCB4\uAC00 \uD3D0\uC218 \uCC98\uB9AC \uAE30\uC900\uC744 \uC815\uC0C1\uC801\uC73C\uB85C \uC900\uC218\uD55C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uAE30\uC0AC\uC5D0\uC11C\uB294 \uCD5C\uADFC \uC2E4\uC2DC\uB41C \uAC80\uC0AC\uC5D0\uC11C\uB3C4 \uD2B9\uC774 \uC0AC\uD56D\uC774 \uBC1C\uACAC\uB418\uC9C0 \uC54A\uC558\uC73C\uBA70 \uC218\uC9C8 \uAD00\uB9AC\uC5D0 \uBB38\uC81C\uAC00 \uC5C6\uC5C8\uB2E4\uACE0 \uC804\uD588\uC2B5\uB2C8\uB2E4. \uD658\uACBD\uBD80\uB294 \uCD5C\uADFC \uC81C\uAE30\uB41C \uC218\uC9C8 \uC624\uC5FC \uC758\uD639\uC740 \uC0AC\uC2E4\uACFC \uB2E4\uB974\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -8
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -10
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uD658\uACBD \uBB38\uC81C\uC5D0 \uB300\uD55C \uC6B0\uB824\uAC00 \uC904\uC5B4\uB4E4\uBA70 \uC815\uBD80\uC5D0 \uB300\uD55C \uBE44\uD310 \uC5EC\uB860\uB3C4 \uB2E4\uC18C \uAC00\uB77C\uC549\uC558\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC774\uD6C4 \uC2E4\uC81C \uC870\uC0AC\uC5D0\uC11C \uAE30\uC900 \uC704\uBC18 \uC0AC\uB840\uAC00 \uD655\uC778\uB418\uBA74\uC11C \uC798\uBABB\uB41C \uC815\uBCF4\uB97C \uBCF4\uB3C4\uD55C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
