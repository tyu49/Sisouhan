  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uACF5\uC2DD \uBC1C\uD45C\uC640 \uC77C\uCE58\uD558\uB294 \uC815\uBCF4\uB97C \uC804\uB2EC\uD574 \uC2E0\uB8B0\uB3C4\uAC00 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uC815\uBD80\uC758 \uBC29\uC5ED \uB300\uC751\uC5D0 \uC548\uB3C4\uD558\uB294 \uC5EC\uB860\uC774 \uC0DD\uAE30\uBA70 \uD601\uBA85\uB3C4\uB294 \uC18C\uD3ED \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
