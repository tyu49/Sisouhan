  <ManagingID>k__BackingField: day_3_4
  <AppearingDay>k__BackingField: 3
  <HeadLine>k__BackingField: "\uAC10\uC5FC\uBCD1 \uC99D\uAC00\uC138 \uB454\uD654, \uBCF4\uAC74\uB2F9\uAD6D \"\uCD94\uAC00 \uBC29\uC5ED\uC870\uCE58 \uC5C6\uB2E4\""
  <Text>k__BackingField: "\uBCF4\uAC74\uB2F9\uAD6D\uC740 \uCD5C\uADFC \uAC10\uC5FC\uBCD1 \uD655\uC9C4\uC790 \uC99D\uAC00\uC138\uAC00 \uC774\uC804\uBCF4\uB2E4 \uB454\uD654\uB410\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4. \uD604\uC7AC \uC758\uB8CC \uB300\uC751 \uC5EC\uB825\uB3C4 \uC548\uC815\uC801\uC73C\uB85C \uC720\uC9C0\uB418\uACE0 \uC788\uC5B4 \uB2F9\uBD84\uAC04 \uCD94\uAC00\uC801\uC778 \uBC29\uC5ED \uC870\uCE58\uB294 \uC2DC\uD589\uD558\uC9C0 \uC54A\uC744 \uC608\uC815\uC785\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
