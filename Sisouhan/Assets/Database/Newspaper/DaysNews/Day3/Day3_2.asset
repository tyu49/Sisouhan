  <ManagingID>k__BackingField: day_3_2
  <AppearingDay>k__BackingField: 3
  <HeadLine>k__BackingField: "\uB178\uD6C4 \uAD50\uB7C9 \uBCF4\uC218, 3\uB144\uC9F8 \uBBF8\uB904\uC84C\uB2E4"
  <Text>k__BackingField: "\uC815\uBD80 \uC0B0\uD558 \uACF5\uAE30\uC5C5 XX\uACF5\uC0AC\uC758 \uB0B4\uBD80 \uC548\uC804\uC810\uAC80 \uC790\uB8CC\uC5D0 \uB530\uB974\uBA74 XX\uAD50\uB294 \uCD5C\uADFC 3\uB144\uAC04 \uBC18\uBCF5\uC801\uC73C\uB85C \uBCF4\uC218\uAC00 \uD544\uC694\uD558\uB2E4\uB294 \uC9C0\uC801\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4. \uC77C\uBD80 \uC810\uAC80\uC5D0\uC11C\uB294 \uADE0\uC5F4\uACFC \uB178\uD6C4 \uBD80\uD488 \uAD50\uCCB4 \uD544\uC694\uC131\uC774 \uAD6C\uCCB4\uC801\uC73C\uB85C \uC5B8\uAE09\uB410\uC9C0\uB9CC \uC2E4\uC81C \uBCF4\uC218\uB294 \uC784\uC2DC \uC870\uCE58\uC5D0 \uADF8\uCCE4\uC2B5\uB2C8\uB2E4. \uACF5\uC0AC\uB294 \uC608\uC0B0 \uBD80\uC871\uC744 \uC774\uC720\uB85C \uC8FC\uC694 \uBCF4\uC218 \uC77C\uC815\uC744 \uC5EC\uB7EC \uCC28\uB840 \uC5F0\uAE30\uD55C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 11
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 9
  <ApprovedText>k__BackingField: "\uC2DC\uBBFC\uB4E4\uC758 \uC548\uC804\uACFC \uC9C1\uACB0\uB41C \uBB38\uC81C\uB97C \uC815\uBD80\uAC00 \uC54C\uACE0\uB3C4 \uBBF8\uB904\uC654\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uC54C\uB824\uC9C0\uBA70 \uD070 \uBC18\uBC1C\uC774 \uC77C\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4. \uB0B4\uBD80 \uC790\uB8CC\uB97C \uC774\uC6A9\uD55C \uB2E8\uB3C5 \uBCF4\uB3C4\uC600\uAE30 \uB54C\uBB38\uC5D0 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
