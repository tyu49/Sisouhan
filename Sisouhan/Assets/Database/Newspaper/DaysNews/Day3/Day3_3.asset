  <ManagingID>k__BackingField: day_3_3
  <AppearingDay>k__BackingField: 3
  <HeadLine>k__BackingField: "\uD655\uC9C4\uC790 \uB2E4\uC2DC \uD3ED\uC99D, \uC815\uBD80 \uACB0\uAD6D \uC804\uAD6D \uB2E8\uC704 \uC774\uB3D9 \uC81C\uD55C \uAC80\uD1A0"
  <Text>k__BackingField: "\uCD5C\uADFC \uAC10\uC5FC\uBCD1 \uD655\uC9C4\uC790\uAC00 \uB2E4\uC2DC \uAE09\uACA9\uD788 \uB298\uC5B4\uB098\uBA74\uC11C \uC815\uBD80\uAC00 \uC804\uAD6D \uB2E8\uC704 \uC774\uB3D9 \uC81C\uD55C\uACFC \uB2E4\uC911\uC774\uC6A9\uC2DC\uC124 \uC6B4\uC601 \uC911\uB2E8\uC744 \uAC80\uD1A0\uD558\uACE0 \uC788\uB294 \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uAD00\uACC4 \uBD80\uCC98\uB294 \uAE34\uAE09\uD68C\uC758\uB97C \uC5F4\uC5B4 \uAC15\uB825\uD55C \uBC29\uC5ED \uC870\uCE58 \uB3C4\uC785 \uC5EC\uBD80\uB97C \uB17C\uC758 \uC911\uC778 \uAC83\uC73C\uB85C \uC804\uD574\uC84C\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 15
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -7
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uAC15\uB825\uD55C \uC774\uB3D9 \uC81C\uD55C\uC774 \uB2E4\uC2DC \uC2DC\uC791\uB420 \uC218 \uC788\uB2E4\uB294 \uC18C\uC2DD\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uC548\uACFC \uC815\uBD80\uC5D0 \uB300\uD55C \uBC18\uBC1C\uC774 \uD06C\uAC8C \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC774\uD6C4 \uBCF4\uAC74\uB2F9\uAD6D\uC758 \uACF5\uC2DD \uBC1C\uD45C\uC640 \uB2E4\uB978 \uB0B4\uC6A9\uC784\uC774 \uC54C\uB824\uC9C0\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
