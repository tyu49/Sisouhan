  <ManagingID>k__BackingField: day_3_7
  <AppearingDay>k__BackingField: 3
  <HeadLine>k__BackingField: "\uAD6D\uB9BD\uB300 \uB4F1\uB85D\uAE08 \uC9C0\uC6D0 \uCD95\uC18C\uB41C\uB2E4, \uAD50\uC721\uBD80 \uC608\uC0B0 \uC0AD\uAC10 \uACB0\uC815"
  <Text>k__BackingField: "\uAD50\uC721\uBD80\uAC00 \uB0B4\uB144\uB3C4 \uACE0\uB4F1\uAD50\uC721 \uC608\uC0B0\uC744 \uC904\uC774\uBA74\uC11C \uAD6D\uB9BD\uB300\uD559\uAD50 \uB4F1\uB85D\uAE08 \uC9C0\uC6D0 \uB300\uC0C1\uB3C4 \uD568\uAED8 \uCD95\uC18C\uD558\uAE30\uB85C \uACB0\uC815\uD588\uC2B5\uB2C8\uB2E4. \uAD50\uC721\uACC4\uC5D0\uC11C\uB294 \uD559\uC0DD\uB4E4\uC758 \uBD80\uB2F4\uC774 \uB2E4\uC2DC \uCEE4\uC9C8 \uC218 \uC788\uB2E4\uB294 \uC6B0\uB824\uAC00 \uB098\uC624\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 10
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -10
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uD559\uC0DD\uACFC \uD559\uBD80\uBAA8\uB97C \uC911\uC2EC\uC73C\uB85C \uC815\uBD80\uC5D0 \uB300\uD55C \uBC18\uBC1C\uC774 \uBE60\uB974\uAC8C \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uAD50\uC721\uBD80\uAC00 \uC2E4\uC81C\uB85C\uB294 \uC9C0\uC6D0 \uB300\uC0C1\uC744 \uD655\uB300\uD55C\uB2E4\uACE0 \uBC1C\uD45C\uD55C \uC0AC\uC2E4\uC774 \uD655\uC778\uB418\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC815\uBCF4\uB825\uC5D0 \uB300\uD55C \uC758\uC2EC\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
