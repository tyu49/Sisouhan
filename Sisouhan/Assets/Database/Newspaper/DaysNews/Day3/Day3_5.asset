  <ManagingID>k__BackingField: day_3_5
  <AppearingDay>k__BackingField: 3
  <HeadLine>k__BackingField: "\uAC80\uAC8C \uBCC0\uD55C \uAC15\uBB3C, \uD658\uACBD\uBD80\uB294 \uC624\uC5FC \uC5C5\uCCB4\uB97C \uC54C\uACE0\uB3C4 \uC785\uC744 \uB2EB\uC558\uB2E4"
  <Text>k__BackingField: "\uD658\uACBD\uBD80 \uB0B4\uBD80 \uC870\uC0AC\uC5D0\uC11C XX\uAC15 \uC778\uADFC \uC0B0\uC5C5\uB2E8\uC9C0 \uC77C\uBD80 \uC5C5\uCCB4\uAC00 \uD3D0\uC218 \uCC98\uB9AC \uAE30\uC900\uC744 \uC704\uBC18\uD55C \uC815\uD669\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uD658\uACBD\uBD80\uB294 \uC815\uC2DD \uC870\uC0AC \uACB0\uACFC\uAC00 \uB098\uC624\uAE30 \uC804\uAE4C\uC9C0 \uD574\uB2F9 \uC5C5\uCCB4\uC758 \uC774\uB984\uC744 \uACF5\uAC1C\uD558\uC9C0 \uC54A\uAE30\uB85C \uACB0\uC815\uD55C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 12
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 10
  <ApprovedText>k__BackingField: "\uD658\uACBD \uBB38\uC81C\uC640 \uC815\uBD80\uC758 \uC815\uBCF4 \uBE44\uACF5\uAC1C \uACB0\uC815\uC774 \uD568\uAED8 \uC54C\uB824\uC9C0\uBA70 \uC8FC\uBBFC\uB4E4\uC758 \uBC18\uBC1C\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uACF5\uC2DD\uC801\uC73C\uB85C \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC740 \uB0B4\uBD80 \uC870\uC0AC \uB0B4\uC6A9\uC744 \uB2E4\uB8EC \uBCF4\uB3C4\uB77C \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
