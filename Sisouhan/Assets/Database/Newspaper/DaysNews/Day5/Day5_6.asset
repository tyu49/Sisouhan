  <ManagingID>k__BackingField: day_5_6
  <AppearingDay>k__BackingField: 5
  <HeadLine>k__BackingField: "\uBCF5\uC9C0\uC608\uC0B0 8\uCC9C\uB9CC \uC6D0 \uBE7C\uB3CC\uB9B0 \uD300\uC7A5, \uAC80\uCC30 \uAE30\uC18C \uACF5\uC2DD \uBC1C\uD45C"
  <Text>k__BackingField: "\uAC80\uCC30\uC740 XX\uC2DC \uBCF5\uC9C0\uC9C0\uC6D0\uD300\uC7A5\uC774 \uC218\uB144\uC5D0 \uAC78\uCCD0 \uC0AC\uC5C5\uBE44 \uC57D 8\uCC9C\uB9CC \uC6D0\uC744 \uAC1C\uC778 \uACC4\uC88C\uB85C \uBE7C\uB3CC\uB9B0 \uD610\uC758\uB85C \uAE30\uC18C\uB410\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uC2DC\uCCAD\uC740 \uD574\uB2F9 \uC9C1\uC6D0\uC744 \uC9C1\uC704\uD574\uC81C\uD558\uACE0 \uD53C\uD574 \uAE08\uC561 \uD658\uC218 \uC808\uCC28\uB97C \uC9C4\uD589\uD558\uACE0 \uC788\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 4
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uBCF5\uC9C0\uC608\uC0B0\uC744 \uB2F4\uB2F9\uD558\uB358 \uACF5\uBB34\uC6D0\uC758 \uBC94\uC8C4\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD84\uB178\uAC00 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uB3D9\uC2DC\uC5D0 \uC218\uC0AC\uAE30\uAD00\uACFC \uC9C0\uC790\uCCB4\uAC00 \uC0AC\uAC74\uC744 \uACF5\uAC1C\uD558\uACE0 \uC870\uCE58\uC5D0 \uB098\uC120 \uC0AC\uC2E4\uB3C4 \uD568\uAED8 \uC54C\uB824\uC9C0\uBA74\uC11C \uC815\uBD80 \uC804\uCCB4\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC758 \uD655\uC0B0\uC740 \uB2E4\uC18C \uC81C\uD55C\uB410\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
