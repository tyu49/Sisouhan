  <HeadLine>k__BackingField: "\uBCF5\uC9C0\uC608\uC0B0 8\uCC9C\uB9CC \uC6D0 \uBE7C\uB3CC\uB9B0 \uD300\uC7A5"
  <Text>k__BackingField: "\uAC80\uCC30\uC740 XX\uC2DC \uBCF5\uC9C0\uC9C0\uC6D0\uD300\uC7A5\uC774 \uC218\uB144\uC5D0 \uAC78\uCCD0 \uC0AC\uC5C5\uBE44 \uC57D 8\uCC9C\uB9CC \uC6D0\uC744 \uAC1C\uC778 \uACC4\uC88C\uB85C \uBE7C\uB3CC\uB9B0 \uD610\uC758\uB85C \uAE30\uC18C\uB410\uB2E4\uACE0 \uBC1C\uD45C\uD587\uC2B5\uB2C8\uB2E4. \uC2DC\uCCAD\uC740 \uD574\uB2F9 \uC9C1\uC6D0\uC744 \uC9C1\uC704\uD574\uC81C\uD558\uACE0 \uD53C\uD574 \uAE08\uC561 \uD658\uC218 \uC808\uCC28\uB97C \uC9C4\uD589\uD558\uACE0 \uC788\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
