  <ApprovedText>k__BackingField: "\uBCF5\uC9C0\uC608\uC0B0\uC744 \uB2F4\uB2F9\uD558\uB358 \uACF5\uBB34\uC6D0\uC758 \uBC94\uC8C4\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD84\uB178\uAC00 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uC0AC\uAC74 \uC790\uCCB4\uB294 \uACF5\uC2DD \uBC1C\uD45C\uC5D0 \uADFC\uAC70\uD588\uC9C0\uB9CC \uBCF8\uBB38\uC758 \uB208\uC5D0 \uB744\uB294 \uC624\uD0C8\uC790\uB85C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
