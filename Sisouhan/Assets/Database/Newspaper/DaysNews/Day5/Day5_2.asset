  <ManagingID>k__BackingField: day_5_2
  <AppearingDay>k__BackingField: 5
  <HeadLine>k__BackingField: "\uC0AC\uC5C5 \uB530\uB0B8 \uC5C5\uCCB4\uAC00 \uC7A5\uAD00\uC758 \uD638\uD154\uBE44\uB97C \uB0C8\uB2E4, XX\uBD80 \uC811\uB300 \uC758\uD639"
  <Text>k__BackingField: "XX\uBD80 \uB0B4\uBD80 \uAC10\uCC30\uC790\uB8CC\uC5D0 \uB530\uB974\uBA74 \uC7A5\uAD00\uC740 \uBD80\uCC98 \uC0AC\uC5C5\uC744 \uC218\uC8FC\uD55C \uC5C5\uCCB4 \uAD00\uACC4\uC790\uB85C\uBD80\uD130 \uACE0\uAC00 \uC219\uBC15\uACFC \uC2DD\uC0AC \uB4F1\uC744 \uC81C\uACF5\uBC1B\uC740 \uC815\uD669\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uC5C5\uCCB4\uB294 \uAC19\uC740 \uAE30\uAC04 \uBD80\uCC98\uAC00 \uC9C4\uD589\uD55C \uB300\uD615 \uC0AC\uC5C5\uC758 \uACC4\uC57D \uB300\uC0C1\uC790\uB85C \uC120\uC815\uB410\uC73C\uBA70 \uAC10\uCC30\uD300\uC740 \uB450 \uC0AC\uC548\uC758 \uC5F0\uAD00\uC131\uC744 \uC870\uC0AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 13
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 11
  <ApprovedText>k__BackingField: "\uC815\uBD80 \uC0AC\uC5C5\uC744 \uC218\uC8FC\uD55C \uC5C5\uCCB4\uC640 \uC7A5\uAD00 \uC0AC\uC774\uC758 \uBD80\uC801\uC808\uD55C \uAD00\uACC4\uAC00 \uC54C\uB824\uC9C0\uBA74\uC11C \uC815\uBD80\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uD06C\uAC8C \uB192\uC544\uC84C\uC2B5\uB2C8\uB2E4. \uB0B4\uBD80 \uAC10\uCC30 \uB2E8\uACC4\uC758 \uC815\uBCF4\uB97C \uBCF4\uB3C4\uD55C \uB9CC\uD07C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
