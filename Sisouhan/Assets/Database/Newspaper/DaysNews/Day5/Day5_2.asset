  <HeadLine>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 G \uCE5C\uB3D9\uC0DD \uD68C\uC0AC \uACF5\uAC1C"
  <Text>k__BackingField: "\uAE08\uD488\uC218\uC218 \uC758\uD639\uC744 \uBC1B\uB294 \uAD6D\uD68C\uC758\uC6D0 G\uC758 \uCE5C\uB3D9\uC0DD\uC740 \uD574\uB2F9 \uC0AC\uAC74\uACFC \uC9C1\uC811\uC801\uC778 \uAD00\uB828\uC774 \uC5C6\uB294 \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC218\uC0AC\uB098 \uAC10\uCC30\uC5D0\uC11C\uB3C4 \uCE5C\uB3D9\uC0DD \uD68C\uC0AC\uC758 \uAD00\uC5EC \uC815\uD669\uC740 \uB098\uD0C0\uB098\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uAE30\uC0AC\uC5D0\uB294 \uD68C\uC0AC\uBA85\uACFC \uC5C5\uC885 \uB4F1 \uC2E0\uC0C1\uC815\uBCF4\uAC00 \uD568\uAED8 \uACF5\uAC1C\uB410\uC2B5\uB2C8\uB2E4."
