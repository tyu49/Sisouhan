  <HeadLine>k__BackingField: "\uC2DC\uC758\uC6D0 H, \uBC95\uC778\uCE74\uB4DC \uC368\uBC84\uB837\uB2E4"
  <Text>k__BackingField: "\uB0B4\uBD80 \uD68C\uACC4\uAC10\uC0AC\uC5D0\uC11C \uD604\uC9C1 XX\uC2DC\uC758\uC6D0 H\uAC00 \uACF5\uC775\uC7AC\uB2E8 \uBE44\uC6A9 \uC77C\uBD80\uB97C \uAC1C\uC778\uC801\uC778 \uC2DD\uC0AC\uC640 \uC774\uB3D9 \uBE44\uC6A9 \uB4F1\uC5D0 \uC0AC\uC6A9\uD55C \uC815\uD669\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uAC10\uC0AC\uD300\uC740 \uC5EC\uB7EC \uC9C0\uCD9C \uD56D\uBAA9\uC774 \uC7AC\uB2E8 \uC0AC\uC5C5\uACFC \uC9C1\uC811\uC801\uC778 \uAD00\uB828\uC774 \uC5C6\uB2E4\uACE0 \uD310\uB2E8\uD55C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uAC10\uC0AC \uACB0\uACFC\uB294 \uC544\uC9C1 \uC678\uBD80\uC5D0 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
