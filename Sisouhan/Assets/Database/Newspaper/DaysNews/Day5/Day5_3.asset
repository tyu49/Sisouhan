  <ApprovedText>k__BackingField: "\uACF5\uC775\uC7AC\uB2E8 \uBE44\uC6A9\uC744 \uC0AC\uC801\uC73C\uB85C \uC0AC\uC6A9\uD588\uB2E4\uB294 \uC758\uD639\uC5D0 \uBC18\uBC1C\uC774 \uCEE4\uC84C\uC9C0\uB9CC \uC81C\uBAA9\uC758 \uC624\uD0C8\uC790\uC640 \uBE44\uACF5\uAC1C \uC815\uBCF4 \uBCF4\uB3C4\uB85C \uC2E0\uB8B0\uB3C4\uB294 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
