  <ManagingID>k__BackingField: day_5_3
  <AppearingDay>k__BackingField: 5
  <HeadLine>k__BackingField: "\uACF5\uC0AC \uACC4\uC57D \uB4A4 \uC624\uAC04 \uB3C8, XX\uCCAD \uD300\uC7A5 \uAE08\uD488\uC218\uC218 \uC815\uD669 \uD3EC\uCC29"
  <Text>k__BackingField: "\uC218\uC0AC\uAE30\uAD00 \uB0B4\uBD80 \uC790\uB8CC\uC5D0 \uB530\uB974\uBA74 XX\uCCAD \uC2DC\uC124\uACC4\uC57D\uD300\uC7A5\uC740 \uCD5C\uADFC \uACF5\uC0AC\uB97C \uC218\uC8FC\uD55C \uC5C5\uCCB4 \uB450 \uACF3\uC73C\uB85C\uBD80\uD130 \uC5EC\uB7EC \uCC28\uB840 \uAE08\uD488\uC744 \uBC1B\uC740 \uC815\uD669\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC218\uC0AC\uAE30\uAD00\uC740 \uACC4\uC88C \uD750\uB984\uACFC \uACC4\uC57D \uC2EC\uC0AC \uACFC\uC815\uC758 \uC5F0\uAD00\uC131\uC744 \uC870\uC0AC\uD558\uACE0 \uC788\uC73C\uBA70 \uD574\uB2F9 \uD300\uC7A5\uC758 \uC2E0\uBCD1\uB3C4 \uD655\uBCF4\uD55C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 14
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 12
  <ApprovedText>k__BackingField: "\uACF5\uACF5 \uACC4\uC57D\uC744 \uB2F4\uB2F9\uD558\uB294 \uACF5\uBB34\uC6D0\uC774 \uC5C5\uCCB4\uB85C\uBD80\uD130 \uAE08\uD488\uC744 \uBC1B\uC558\uB2E4\uB294 \uC18C\uC2DD\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBC18\uBC1C\uC774 \uD06C\uAC8C \uC77C\uC5C8\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uC218\uC0AC\uAE30\uAD00\uC774 \uBC1C\uD45C\uD558\uC9C0 \uC54A\uC740 \uB0B4\uC6A9\uC744 \uBA3C\uC800 \uBCF4\uB3C4\uD558\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
