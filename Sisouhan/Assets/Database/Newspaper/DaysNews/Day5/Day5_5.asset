  <HeadLine>k__BackingField: "\uC5F0\uC1C4 \uBE48\uC9D1\uD138\uC774\uBC94 \uB610 \uB193\uCCE3\uB2E4"
  <Text>k__BackingField: "\uC218\uB3C4\uAD8C \uC5EC\uB7EC \uC9C0\uC5ED\uC5D0\uC11C \uBE44\uC2B7\uD55C \uBC29\uC2DD\uC758 \uBE48\uC9D1\uD138\uC774 \uC0AC\uAC74\uC774 \uBC18\uBCF5\uB418\uBA74\uC11C \uACBD\uCC30\uC740 \uB3D9\uC77C \uC778\uBB3C\uC774 \uC5F0\uAD00\uB41C \uAC83\uC73C\uB85C \uBCF4\uACE0 \uC6A9\uC758\uC790\uB97C \uD2B9\uC815\uD588\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC218\uC0AC\uAC00 \uC774\uC5B4\uC9C0\uB294 \uB3D9\uC548\uC5D0\uB3C4 \uCD94\uAC00 \uC2E0\uACE0\uAC00 \uC811\uC218\uB410\uC73C\uBA70 \uD604\uC7AC\uAE4C\uC9C0 \uD574\uB2F9 \uC6A9\uC758\uC790\uB97C \uAC80\uAC70\uD558\uC9C0 \uBABB\uD55C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 10
  - <Effect>k__BackingField: 1
