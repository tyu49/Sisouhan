  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 8
  <ApprovedText>k__BackingField: "\uBC18\uBCF5\uB418\uB294 \uBC94\uC8C4\uC5D0\uB3C4 \uC6A9\uC758\uC790\uB97C \uC7A1\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uC548\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uC81C\uBAA9\uC758 \uC624\uD0C8\uC790\uC640 \uBE44\uACF5\uAC1C \uC218\uC0AC\uC815\uBCF4 \uBCF4\uB3C4\uB85C \uC2E0\uB8B0\uB3C4\uB3C4 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
