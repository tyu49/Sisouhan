  <HeadLine>k__BackingField: "12\uB144 \uC804 \uC74C\uC8FC\uC6B4\uC804 \uD310\uACB0 \uB4A4\uB2A6\uAC8C \uD655\uC778, \uD604\uC9C1 \uCC28\uAD00\uC758 \uACFC\uAC70 \uC804\uACFC"
  <Text>k__BackingField: "\uACF5\uAC1C\uB41C \uBC95\uC6D0 \uD310\uACB0 \uAE30\uB85D\uC5D0\uC11C \uD604\uC9C1 XX\uBD80 \uCC28\uAD00\uC774 12\uB144 \uC804 \uC74C\uC8FC\uC6B4\uC804\uC73C\uB85C \uBC8C\uAE08\uD615\uC744 \uC120\uACE0\uBC1B\uC740 \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uB2F9\uC2DC \uC0AC\uAC74\uC740 \uD604\uC7AC\uC758 \uACF5\uC9C1 \uC784\uBA85 \uC774\uC804\uC5D0 \uBC1C\uC0DD\uD588\uC73C\uBA70 \uCC28\uAD00 \uCE21\uC740 \uACFC\uAC70 \uC798\uBABB\uC5D0 \uB300\uD574 \uC774\uBBF8 \uCC98\uBC8C\uC744 \uBC1B\uC558\uACE0 \uC774\uD6C4 \uAC19\uC740 \uBB38\uC81C\uAC00 \uBC18\uBCF5\uB41C \uC801\uC740 \uC5C6\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uACE0\uC704 \uACF5\uC9C1\uC790\uC758 \uACFC\uAC70 \uC804\uACFC\uAC00 \uC54C\uB824\uC9C0\uBA70 \uC77C\uBD80 \uC2DC\uBBFC\uB4E4\uC758 \uBE44\uD310\uC774 \uC774\uC5B4\uC84C\uC2B5\uB2C8\uB2E4. \uB204\uAD6C\uB098 \uD655\uC778 \uAC00\uB2A5\uD55C \uD310\uACB0 \uAE30\uB85D\uC744 \uADFC\uAC70\uB85C \uBCF4\uB3C4\uD574 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uAC00 \uC62C\uB77C\uAC14\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
