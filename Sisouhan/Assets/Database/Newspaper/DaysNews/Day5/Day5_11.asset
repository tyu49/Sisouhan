  <HeadLine>k__BackingField: "\uD6A1\uB839 \uC9C1\uC6D0 \uC989\uC2DC \uC9C1\uC704\uD574\uCC44"
  <Text>k__BackingField: "XX\uC2DC\uCCAD\uC740 \uC790\uCCB4 \uAC10\uC0AC\uC5D0\uC11C \uD55C \uC9C1\uC6D0\uC774 \uC0AC\uC5C5\uBE44 \uC77C\uBD80\uB97C \uAC1C\uC778\uC801\uC778 \uC6A9\uB3C4\uB85C \uC0AC\uC6A9\uD55C \uC815\uD669\uC744 \uD655\uC778\uD588\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uC2DC\uCCAD\uC740 \uAD00\uB828 \uD68C\uACC4 \uC790\uB8CC\uB97C \uC7AC\uAC80\uD1A0\uD55C \uB4A4 \uD574\uB2F9 \uC9C1\uC6D0\uC744 \uC989\uC2DC \uC9C1\uC704\uD574\uC81C\uD588\uC73C\uBA70 \uBD80\uC801\uC808\uD558\uAC8C \uC0AC\uC6A9\uB41C \uAE08\uC561\uC758 \uD658\uC218\uC640 \uCD94\uAC00 \uC9D5\uACC4 \uC5EC\uBD80\uB3C4 \uAC80\uD1A0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -4
  - <Effect>k__BackingField: 1
