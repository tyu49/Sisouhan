  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uACF5\uACF5\uC790\uAE08\uC744 \uC720\uC6A9\uD55C \uC9C1\uC6D0\uC5D0 \uB300\uD55C \uC989\uAC01\uC801\uC778 \uC870\uCE58\uAC00 \uC54C\uB824\uC9C0\uBA70 \uAE30\uAD00\uC758 \uB300\uC751\uC744 \uAE0D\uC815\uC801\uC73C\uB85C \uD3C9\uAC00\uD558\uB294 \uC5EC\uB860\uC774 \uC77C\uBD80 \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC81C\uBAA9\uC758 \uC624\uD0C8\uC790\uB85C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
