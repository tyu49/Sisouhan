  <HeadLine>k__BackingField: "\uBE44\uB9AC \uD300\uC7A5 \uC989\uC2DC \uC9C1\uC704\uD574\uCC44"
  <Text>k__BackingField: "\uC815\uBD80\uB294 XX\uBD80 \uAD6C\uB9E4\uAD00\uB9AC\uD300\uC7A5\uC774 \uACC4\uC57D \uC5C5\uCCB4\uC640 \uC0AC\uC801\uC778 \uAE08\uC804 \uAC70\uB798\uB97C \uD55C \uC0AC\uC2E4\uC774 \uC790\uCCB4 \uAC10\uC0AC\uC5D0\uC11C \uD655\uC778\uB410\uB2E4\uBA70 \uD574\uB2F9 \uD300\uC7A5\uC744 \uC989\uC2DC \uC9C1\uC704\uD574\uC81C\uD558\uACE0 \uC0AC\uAC74\uC744 \uC218\uC0AC\uAE30\uAD00\uC5D0 \uB118\uACBC\uB2E4\uACE0 \uACF5\uC2DD \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uAC10\uC0AC \uACB0\uACFC\uC640 \uD6C4\uC18D \uC870\uCE58\uB3C4 \uD568\uAED8 \uACF5\uAC1C\uB410\uC2B5\uB2C8\uB2E4."
