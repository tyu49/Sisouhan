  <HeadLine>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 A, \uC815\uCE58\uC790\uAE08 \uC0AC\uC801 \uC0AC\uC6A9 \uC758\uD639"
  <Text>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 A\uAC00 \uC815\uCE58\uC790\uAE08 \uAC00\uC6B4\uB370 \uC77C\uBD80\uB97C \uC758\uC815\uD65C\uB3D9\uACFC \uC9C1\uC811 \uAD00\uB828\uC774 \uC5C6\uB294 \uC219\uBC15\uBE44\uC640 \uAC1C\uC778 \uCC28\uB7C9 \uBE44\uC6A9\uC5D0 \uC0AC\uC6A9\uD55C \uC815\uD669\uC774 \uC120\uAC70\uAD00\uB9AC\uAE30\uAD00\uC758 \uC870\uC0AC\uC5D0\uC11C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC870\uC0AC \uC790\uB8CC\uC5D0\uB294 \uC5EC\uB7EC \uCC28\uB840\uC758 \uC9C0\uCD9C \uB0B4\uC5ED\uACFC \uC0AC\uC6A9 \uBAA9\uC801\uC5D0 \uB300\uD55C \uC18C\uBA85\uC774 \uCDA9\uBD84\uD558\uC9C0 \uC54A\uB2E4\uB294 \uB0B4\uC6A9\uC774 \uD3EC\uD568\uB41C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 12
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 9
  <ApprovedText>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0\uC774 \uC815\uCE58\uC790\uAE08\uC744 \uC0AC\uC801\uC73C\uB85C \uC0AC\uC6A9\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD84\uB178\uAC00 \uD06C\uAC8C \uBC88\uC84C\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uACF5\uC2DD \uBC1C\uD45C \uC804\uC778 \uC870\uC0AC \uB0B4\uC6A9\uC744 \uB2E4\uB8EC \uB2E8\uB3C5\uBCF4\uB3C4\uB77C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB2E4\uC18C \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
