  <HeadLine>k__BackingField: "\uC2DC\uC758\uC6D0 H, \uACF5\uAE08\uC73C\uB85C \uAC1C\uC778\uC5EC\uD589?"
  <Text>k__BackingField: "XX\uC2DC\uC758\uC6D0 H\uAC00 \uACF5\uC775\uC7AC\uB2E8 \uBE44\uC6A9 \uC77C\uBD80\uB97C \uAC1C\uC778\uC801\uC778 \uC6A9\uB3C4\uB85C \uC0AC\uC6A9\uD55C \uC815\uD669\uC774 \uB0B4\uBD80 \uAC10\uC0AC\uC5D0\uC11C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uD68C\uACC4 \uB0B4\uC5ED\uC5D0\uB294 \uACF5\uC2DD \uD589\uC0AC\uC640 \uAD00\uB828\uC131\uC744 \uD655\uC778\uD558\uAE30 \uC5B4\uB824\uC6B4 \uC9C0\uCD9C\uC774 \uC5EC\uB7EC \uAC74 \uD3EC\uD568\uB3FC \uC788\uC5C8\uACE0 \uAC10\uC0AC\uD300\uC740 \uC0AC\uC6A9 \uBAA9\uC801\uC5D0 \uB300\uD55C \uC18C\uBA85\uC744 \uC694\uAD6C\uD55C \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
