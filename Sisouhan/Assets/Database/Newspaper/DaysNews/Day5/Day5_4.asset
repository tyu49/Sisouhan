  <ManagingID>k__BackingField: day_5_4
  <AppearingDay>k__BackingField: 5
  <HeadLine>k__BackingField: "\"\uADF8 \uBB38\uC11C \uC5C6\uC560\uB77C\" \uAD6D\uD68C\uC758\uC6D0 B, \uBCF4\uC88C\uC9C4\uC5D0 \uC99D\uAC70 \uC0AD\uC81C \uC9C0\uC2DC\uD588\uB098"
  <Text>k__BackingField: "\uACBD\uCC30 \uC218\uC0AC\uC790\uB8CC\uC5D0\uC11C \uAD6D\uD68C\uC758\uC6D0 B\uAC00 \uC790\uC2E0\uC758 \uBCF4\uC88C\uC9C4\uC5D0\uAC8C \uD2B9\uC815 \uD68C\uACC4 \uC790\uB8CC\uC640 \uC5F0\uB77D \uAE30\uB85D\uC744 \uC0AD\uC81C\uD558\uB3C4\uB85D \uC9C0\uC2DC\uD588\uB2E4\uB294 \uC9C4\uC220\uC774 \uD655\uBCF4\uB41C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uACBD\uCC30\uC740 \uC2E4\uC81C \uC790\uB8CC \uC0AD\uC81C \uC5EC\uBD80\uC640 \uC9C0\uC2DC\uAC00 \uAE30\uC874 \uC218\uC0AC\uC640 \uAD00\uB828\uB410\uB294\uC9C0\uB97C \uD655\uC778\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 13
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 10
  <ApprovedText>k__BackingField: "\uD604\uC9C1 \uAD6D\uD68C\uC758\uC6D0\uC774 \uC218\uC0AC\uC640 \uAD00\uB828\uB41C \uC790\uB8CC \uC0AD\uC81C\uB97C \uC9C0\uC2DC\uD588\uB2E4\uB294 \uC758\uD639\uC774 \uC54C\uB824\uC9C0\uBA70 \uC815\uCE58\uAD8C \uC804\uBC18\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC740 \uC218\uC0AC \uB0B4\uC6A9\uC744 \uB2E4\uB8EC \uB2E8\uB3C5\uBCF4\uB3C4\uB77C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
