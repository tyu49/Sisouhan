  <HeadLine>k__BackingField: "\uAC15\uB3C4 \uC6A9\uC758\uC790 \uC2E0\uC18D \uAC80\uAC70"
  <Text>k__BackingField: "\uACBD\uCC30\uC740 \uC624\uB298 \uC624\uC804 \uBC1C\uC0DD\uD55C \uAC15\uB3C4 \uC0AC\uAC74 \uC2E0\uACE0\uB97C \uC811\uC218\uD55C \uB4A4 \uC8FC\uBCC0 \uBAA9\uACA9\uC790 \uC9C4\uC220\uACFC \uD604\uC7A5 \uC790\uB8CC\uB97C \uD655\uC778\uD574 \uC6A9\uC758\uC790\uB97C \uD2B9\uC815\uD588\uC2B5\uB2C8\uB2E4. \uC774\uD6C4 \uC218\uC0C9\uC744 \uC9C4\uD589\uD55C \uB05D\uC5D0 \uC0AC\uAC74 \uBC1C\uC0DD \uB2F9\uC77C \uC6A9\uC758\uC790\uB97C \uAC80\uAC70\uD588\uC73C\uBA70 \uCD94\uAC00 \uD53C\uD574 \uC5EC\uBD80\uB97C \uC870\uC0AC\uD558\uACE0 \uC788\uB2E4\uACE0 \uACF5\uC2DD \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 1
