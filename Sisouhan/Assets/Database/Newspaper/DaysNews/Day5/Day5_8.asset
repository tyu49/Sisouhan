  <ManagingID>k__BackingField: day_5_8
  <AppearingDay>k__BackingField: 5
  <HeadLine>k__BackingField: "\uC555\uC218\uC218\uC0C9 \uC804 \uD734\uB300\uC804\uD654 \uD3D0\uAE30 \uC758\uD639"
  <Text>k__BackingField: "\uC218\uC0AC\uAE30\uAD00 \uB0B4\uBD80 \uAE30\uB85D\uC5D0 \uB530\uB974\uBA74 XX\uBD80 \uC7A5\uAD00 \uBCF4\uC88C\uD300\uC7A5\uC774 \uC555\uC218\uC218\uC0C9\uC774 \uC9C4\uD589\uB418\uAE30 \uD558\uB8E8 \uC804 \uC5C5\uBB34\uC6A9 \uD734\uB300\uC804\uD654\uB97C \uAD50\uCCB4\uD558\uACE0 \uAE30\uC874 \uAE30\uAE30\uB97C \uD3D0\uAE30\uD55C \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC218\uC0AC\uD300\uC740 \uBCF4\uC88C\uD300\uC7A5\uC774 \uC555\uC218\uC218\uC0C9 \uACC4\uD68D\uC744 \uC0AC\uC804\uC5D0 \uC804\uB2EC\uBC1B\uC558\uB294\uC9C0\uC640 \uAD00\uB828 \uC790\uB8CC\uAC00 \uC758\uB3C4\uC801\uC73C\uB85C \uC0AD\uC81C\uB410\uB294\uC9C0\uB97C \uC870\uC0AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 11
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 9
  <ApprovedText>k__BackingField: "\uC218\uC0AC\uC815\uBCF4\uAC00 \uC815\uBD80 \uB0B4\uBD80\uC5D0\uC11C \uBBF8\uB9AC \uC0C8\uC5B4\uB098\uAC14\uC744 \uAC00\uB2A5\uC131\uC774 \uC81C\uAE30\uB418\uBA74\uC11C \uC2DC\uBBFC\uB4E4\uC758 \uC758\uC2EC\uACFC \uBD88\uC2E0\uC774 \uD06C\uAC8C \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uC218\uC0AC \uC911\uC778 \uBBFC\uAC10\uD55C \uB0B4\uC6A9\uC744 \uB2E8\uB3C5\uC73C\uB85C \uB2E4\uB8EC \uD0D3\uC5D0 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
