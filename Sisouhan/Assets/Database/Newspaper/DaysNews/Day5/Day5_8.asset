  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uC2E0\uC18D\uD55C \uAC80\uAC70 \uC18C\uC2DD\uC5D0 \uACBD\uCC30 \uB300\uC751\uC744 \uAE0D\uC815\uC801\uC73C\uB85C \uD3C9\uAC00\uD558\uB294 \uC5EC\uB860\uC774 \uB298\uBA74\uC11C \uD601\uBA85\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4. \uACF5\uAC1C\uB41C \uC0AC\uAC74\uC744 \uC815\uD655\uD788 \uBCF4\uB3C4\uD574 \uC2E0\uB8B0\uB3C4\uB294 \uC0C1\uC2B9\uD588\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
