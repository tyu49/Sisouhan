  <ManagingID>k__BackingField: day_2_8
  <AppearingDay>k__BackingField: 2
  <HeadLine>k__BackingField: "\uC0C8\uBCBD \uD654\uC7AC \uB9C9\uC544\uB0B8 \uC18C\uBC29\uAD00\uB4E4, \uC8FC\uBBFC 40\uC5EC \uBA85 \uBB34\uC0AC \uB300\uD53C"
  <Text>k__BackingField: "\uC624\uB298 \uC0C8\uBCBD XX\uB3D9\uC758 \uD55C \uB2E4\uC138\uB300\uC8FC\uD0DD\uC5D0\uC11C \uD654\uC7AC\uAC00 \uBC1C\uC0DD\uD588\uC9C0\uB9CC \uC2E0\uACE0\uB97C \uBC1B\uACE0 \uCD9C\uB3D9\uD55C \uC18C\uBC29\uB300\uAC00 \uBE60\uB974\uAC8C \uC8FC\uBBFC\uB4E4\uC744 \uB300\uD53C\uC2DC\uD0A4\uBA70 \uD070 \uC778\uBA85 \uD53C\uD574\uB97C \uB9C9\uC558\uC2B5\uB2C8\uB2E4. \uC18C\uBC29\uB2F9\uAD6D\uC740 \uD604\uC7A5 \uBE0C\uB9AC\uD551\uC744 \uD1B5\uD574 \uC8FC\uBBFC 40\uC5EC \uBA85\uC774 \uC548\uC804\uD558\uAC8C \uB300\uD53C\uD588\uACE0 \uC815\uD655\uD55C \uD654\uC7AC \uC6D0\uC778\uC744 \uC870\uC0AC \uC911\uC774\uB77C\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -4
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uACF5\uC2DD\uC801\uC73C\uB85C \uD655\uC778\uB41C \uC0AC\uAC74\uC744 \uC815\uD655\uD558\uAC8C \uBCF4\uB3C4\uD574 \uC2E0\uB8B0\uB3C4\uAC00 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uACF5\uACF5\uAE30\uAD00\uC5D0 \uB300\uD55C \uAE0D\uC815\uC801\uC778 \uC5EC\uB860\uC774 \uD615\uC131\uB418\uBA74\uC11C \uD601\uBA85\uB3C4\uB294 \uC870\uAE08 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
