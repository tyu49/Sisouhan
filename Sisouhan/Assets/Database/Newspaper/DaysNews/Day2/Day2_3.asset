  <ManagingID>k__BackingField: day_2_3
  <AppearingDay>k__BackingField: 2
  <HeadLine>k__BackingField: "\uC815\uBD80, \uC601\uC138 \uC790\uC601\uC5C5\uC790 \uC138\uAE08 \uAC10\uBA74 \uD655\uB300"
  <Text>k__BackingField: "\uC815\uBD80\uB294 \uC624\uB298\uBD80\uD130 \uC77C\uC815 \uB9E4\uCD9C \uC774\uD558\uC758 \uC601\uC138 \uC790\uC601\uC5C5\uC790\uB97C \uB300\uC0C1\uC73C\uB85C \uC138\uAE08 \uAC10\uBA74 \uD3ED\uC744 \uD655\uB300\uD55C\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uC815\uBD80 \uBC1C\uD45C \uC790\uB8CC\uC5D0 \uB530\uB974\uBA74 \uB300\uC0C1\uC790\uB294 \uBCC4\uB3C4\uC758 \uBCF5\uC7A1\uD55C \uC2E0\uCCAD \uC808\uCC28 \uC5C6\uC774 \uB2E4\uC74C \uACFC\uC138 \uAE30\uAC04\uBD80\uD130 \uAC10\uBA74 \uD61C\uD0DD\uC744 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -8
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uACF5\uAC1C\uB41C \uC815\uCC45\uC744 \uC815\uD655\uD558\uAC8C \uC804\uB2EC\uD558\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uAC00 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uB3D9\uC2DC\uC5D0 \uC815\uBD80 \uC815\uCC45\uC5D0 \uAE0D\uC815\uC801\uC778 \uBC18\uC751\uC744 \uBCF4\uC774\uB294 \uC2DC\uBBFC\uB4E4\uC774 \uB298\uC5B4\uB098\uBA70 \uD601\uBA85\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
