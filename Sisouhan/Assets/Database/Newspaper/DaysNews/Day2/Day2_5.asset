  <HeadLine>k__BackingField: "\uAE38 \uC783\uC740 \uC544\uC774, \uC2DC\uBBFC\u00B7\uACBD\uCC30 \uACF5\uC870\uB85C \uAD6C\uC870"
  <Text>k__BackingField: "\uC5B4\uC81C \uC624\uD6C4 XX\uC5ED \uC778\uADFC\uC5D0\uC11C \uBCF4\uD638\uC790\uC640 \uB5A8\uC5B4\uC9C4 \uC5B4\uB9B0\uC774\uAC00 \uC2DC\uBBFC\uC758 \uC2E0\uACE0\uC640 \uACBD\uCC30\uC758 \uC218\uC0C9 \uB05D\uC5D0 \uC57D 20\uBD84 \uB9CC\uC5D0 \uAC00\uC871\uC5D0\uAC8C \uB3CC\uC544\uAC14\uC2B5\uB2C8\uB2E4. \uD604\uC7A5\uC5D0 \uC788\uB358 \uC0C1\uC778\uB4E4\uACFC \uC2DC\uBBFC\uB4E4\uC774 \uC544\uC774\uC758 \uC774\uB3D9 \uACBD\uB85C\uB97C \uD655\uC778\uD558\uB294 \uB370 \uB3C4\uC6C0\uC744 \uC8FC\uC5C8\uC73C\uBA70 \uACBD\uCC30\uC740 \uAD00\uB828 \uB0B4\uC6A9\uC744 \uACF5\uC2DD\uC801\uC73C\uB85C \uACF5\uAC1C\uD588\uC2B5\uB2C8\uB2E4."
