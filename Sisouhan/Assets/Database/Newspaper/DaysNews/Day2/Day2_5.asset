  <ManagingID>k__BackingField: day_2_5
  <AppearingDay>k__BackingField: 2
  <HeadLine>k__BackingField: "\uAE38 \uC783\uC740 \uC544\uC774, \uC2DC\uBBFC\u00B7\uACBD\uCC30 \uACF5\uC870\uB85C \uAD6C\uC870"
  <Text>k__BackingField: "\uC5B4\uC81C \uC624\uD6C4 XX\uC5ED \uC778\uADFC\uC5D0\uC11C \uBCF4\uD638\uC790\uC640 \uB5A8\uC5B4\uC9C4 \uC5B4\uB9B0\uC774\uAC00 \uC2DC\uBBFC\uC758 \uC2E0\uACE0\uC640 \uACBD\uCC30\uC758 \uC218\uC0C9 \uB05D\uC5D0 \uC57D 20\uBD84 \uB9CC\uC5D0 \uAC00\uC871\uC5D0\uAC8C \uB3CC\uC544\uAC14\uC2B5\uB2C8\uB2E4. \uD604\uC7A5\uC5D0 \uC788\uB358 \uC0C1\uC778\uB4E4\uACFC \uC2DC\uBBFC\uB4E4\uC774 \uC8FC\uBCC0 \uC0C1\uD669\uC744 \uD655\uC778\uD558\uACE0 \uACBD\uCC30\uC5D0 \uC815\uBCF4\uB97C \uC804\uB2EC\uD558\uBA74\uC11C \uC218\uC0C9 \uBC94\uC704\uB97C \uC881\uD788\uB294 \uB370 \uB3C4\uC6C0\uC744 \uC92C\uC2B5\uB2C8\uB2E4. \uACBD\uCC30\uC740 \uC544\uC774\uAC00 \uBB34\uC0AC\uD788 \uBCF4\uD638\uC790\uC5D0\uAC8C \uC778\uACC4\uB410\uC73C\uBA70 \uAD00\uB828 \uB0B4\uC6A9\uC744 \uACF5\uC2DD\uC801\uC73C\uB85C \uACF5\uAC1C\uD588\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -3
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uACF5\uAC1C\uC801\uC73C\uB85C \uD655\uC778\uB41C \uC0AC\uAC74\uC744 \uC815\uD655\uD788 \uBCF4\uB3C4\uD558\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uAC00 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uACBD\uCC30\uC5D0 \uB300\uD55C \uAE0D\uC815\uC801\uC778 \uC5EC\uB860\uC774 \uC0DD\uACA8 \uD601\uBA85\uB3C4\uB294 \uC18C\uD3ED \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
