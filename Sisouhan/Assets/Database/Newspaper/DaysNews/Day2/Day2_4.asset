  <HeadLine>k__BackingField: "46\uC5B5 \uC4F4 \uACF5\uC6D0 \uACF5\uC0AC, \uC65C \uBA48\uCDC4\uB098"
  <Text>k__BackingField: "\uC2DC\uC5D0\uC11C \uACF5\uAC1C\uD55C \uC62C\uD574 \uC608\uC0B0 \uC9D1\uD589 \uC790\uB8CC\uC5D0 \uB530\uB974\uBA74 XX\uC2DC \uC911\uC559\uACF5\uC6D0 \uC7AC\uC815\uBE44 \uC0AC\uC5C5\uC5D0\uB294 \uC9C0\uAE08\uAE4C\uC9C0 \uC57D 46\uC5B5 \uC6D0\uC774 \uD22C\uC785\uB410\uC9C0\uB9CC \uACF5\uC815\uB960\uC740 \uB2F9\uCD08 \uACC4\uD68D\uBCF4\uB2E4 \uD06C\uAC8C \uB4A4\uCC98\uC9C4 \uAC83\uC73C\uB85C \uB098\uD0C0\uB0AC\uC2B5\uB2C8\uB2E4. \uC2DC\uC758\uD68C \uD68C\uC758\uB85D\uC5D0\uC11C\uB3C4 \uC790\uC7AC\uBE44 \uC99D\uAC00\uC640 \uBC18\uBCF5\uB41C \uC124\uACC4 \uBCC0\uACBD\uC73C\uB85C \uCD94\uAC00 \uBE44\uC6A9\uC774 \uBC1C\uC0DD\uD588\uB2E4\uB294 \uC9C0\uC801\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 6
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uB204\uAD6C\uB098 \uD655\uC778\uD560 \uC218 \uC788\uB294 \uC608\uC0B0 \uC790\uB8CC\uC640 \uD68C\uC758\uB85D\uC744 \uADFC\uAC70\uB85C \uC815\uBD80 \uAE30\uAD00\uC758 \uC608\uC0B0 \uC9D1\uD589\uC744 \uBE44\uD310\uD558\uBA74\uC11C \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uB9CC\uC774 \uCEE4\uC84C\uACE0 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4 \uC5ED\uC2DC \uC62C\uB790\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
