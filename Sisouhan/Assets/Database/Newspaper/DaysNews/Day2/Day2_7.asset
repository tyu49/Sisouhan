  <HeadLine>k__BackingField: "\uACE0\uC704 \uACF5\uBB34\uC6D0, \uC218\uBC31\uB9CC \uC6D0 \uD638\uD654 \uCD9C\uC7A5"
  <Text>k__BackingField: "\uC815\uBD80 \uACF5\uAC1C \uC9C0\uCD9C \uB0B4\uC5ED\uC744 \uD655\uC778\uD55C \uACB0\uACFC \uC77C\uBD80 \uACE0\uC704 \uACF5\uBB34\uC6D0\uB4E4\uC774 \uC9C0\uBC29 \uD68C\uC758 \uCC38\uC11D\uC744 \uC704\uD574 \uACE0\uAC00 \uC219\uBC15\uC2DC\uC124\uACFC \uC0C1\uC704 \uB4F1\uAE09 \uAD50\uD1B5\uD3B8\uC744 \uC774\uC6A9\uD55C \uC0AC\uC2E4\uC774 \uB4DC\uB7EC\uB0AC\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uBD80\uCC98\uB294 \uBAA8\uB4E0 \uBE44\uC6A9\uC774 \uADDC\uC815\uC0C1 \uD5C8\uC6A9\uB418\uB294 \uBC94\uC704\uC600\uB2E4\uACE0 \uBC1D\uD614\uC9C0\uB9CC, \uBE44\uC2B7\uD55C \uC77C\uC815\uC758 \uC77C\uBC18 \uC9C1\uC6D0 \uCD9C\uC7A5\uBE44\uBCF4\uB2E4 \uD070 \uCC28\uC774\uB97C \uBCF4\uC600\uC2B5\uB2C8\uB2E4."
