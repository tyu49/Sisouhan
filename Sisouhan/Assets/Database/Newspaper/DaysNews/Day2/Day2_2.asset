  <HeadLine>k__BackingField: "\uC218\uB3D7\uBB3C \uC624\uC5FC, \uC815\uBD80\uB294 \uC65C \uC228\uACBC\uB098"
  <Text>k__BackingField: "\uCD5C\uADFC \uC218\uB3C4\uAD8C \uC77C\uBD80 \uC815\uC218\uC7A5\uC5D0\uC11C \uC2E4\uC2DC\uB41C \uC218\uC9C8 \uAC80\uC0AC\uC5D0\uC11C \uAE30\uC900\uCE58\uB97C \uB118\uB294 \uC624\uC5FC \uBB3C\uC9C8\uC774 \uAC80\uCD9C\uB41C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC815\uBD80\uB294 \uAC80\uC0AC \uACFC\uC815\uC5D0 \uC624\uB958\uAC00 \uC788\uC744 \uAC00\uB2A5\uC131\uC744 \uC774\uC720\uB85C \uC7AC\uAC80\uC0AC\uB97C \uC9C0\uC2DC\uD588\uC73C\uBA70, \uCD5C\uC885 \uACB0\uACFC\uAC00 \uB098\uC624\uAE30 \uC804\uAE4C\uC9C0 \uD574\uB2F9 \uC0AC\uC2E4\uC744 \uC678\uBD80\uC5D0 \uC54C\uB9AC\uC9C0 \uC54A\uB3C4\uB85D \uAD00\uACC4 \uAE30\uAD00\uC5D0 \uC694\uCCAD\uD55C \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
