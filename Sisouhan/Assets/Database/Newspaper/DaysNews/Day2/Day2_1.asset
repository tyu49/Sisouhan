  <ManagingID>k__BackingField: day_2_1
  <AppearingDay>k__BackingField: 2
  <HeadLine>k__BackingField: "\uBE44 \uC0C8\uACE0 \uAC08\uB77C\uC9C4 \uC784\uB300\uC8FC\uD0DD, \uC815\uBD80\uB294 \uC54C\uC558\uB2E4"
  <Text>k__BackingField: "\uB2E4\uC74C \uB2EC\uBD80\uD130 \uC785\uC8FC\uAC00 \uC608\uC815\uB41C \uC218\uB3C4\uAD8C XX\uC9C0\uAD6C \uACF5\uACF5\uC784\uB300\uC8FC\uD0DD \uC5EC\uB7EC \uB3D9\uC5D0\uC11C \uCC9C\uC7A5 \uB204\uC218\uC640 \uC678\uBCBD \uADE0\uC5F4\uC774 \uBC1C\uACAC\uB41C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uAD6D\uD1A0\uBD80 \uB0B4\uBD80 \uC810\uAC80\uC5D0\uC11C\uB3C4 \uBB38\uC81C\uAC00 \uBCF4\uACE0\uB410\uC9C0\uB9CC \uC785\uC8FC \uC77C\uC815\uC740 \uBCC0\uACBD\uB418\uC9C0 \uC54A\uC558\uC73C\uBA70, \uAD00\uACC4\uC790\uB294 \uC548\uC804\uC5D0\uB294 \uD070 \uBB38\uC81C\uAC00 \uC5C6\uB2E4\uB294 \uC785\uC7A5\uC744 \uB0B4\uBD80\uC801\uC73C\uB85C \uC804\uB2EC\uD55C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 10
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 8
  <ApprovedText>k__BackingField: "\uC815\uBD80\uAC00 \uACF5\uAC1C\uD558\uC9C0 \uC54A\uC740 \uC8FC\uD0DD \uBB38\uC81C\uB97C \uBCF4\uB3C4\uD558\uBA74\uC11C \uB9CE\uC740 \uC2DC\uBBFC\uB4E4\uC774 \uC815\uBD80\uC758 \uB300\uC751\uC5D0 \uBD84\uB178\uD588\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC544\uC9C1 \uB2E4\uB978 \uC5B8\uB860\uC5D0\uC11C \uD655\uC778\uB418\uC9C0 \uC54A\uC740 \uB2E8\uB3C5 \uBCF4\uB3C4\uC600\uAE30 \uB54C\uBB38\uC5D0 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
