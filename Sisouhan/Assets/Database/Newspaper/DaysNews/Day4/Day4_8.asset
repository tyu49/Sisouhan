  <ManagingID>k__BackingField: day_4_8
  <AppearingDay>k__BackingField: 4
  <HeadLine>k__BackingField: "\uBCF4\uB3C4\uBE14\uB85D \uB610 \uAC08\uC544\uC5C5\uC5B4, \uC608\uC0B0 \uB0AD\uBE44?"
  <Text>k__BackingField: "XX\uAD6C\uAC00 \uACF5\uAC1C\uD55C \uC608\uC0B0 \uC790\uB8CC\uC5D0 \uB530\uB974\uBA74 \uC9C0\uB09C\uD574 \uC815\uBE44\uB97C \uB9C8\uCE5C \uC77C\uBD80 \uBCF4\uB3C4 \uAD6C\uAC04\uC5D0 \uC62C\uD574 \uB2E4\uC2DC \uAD50\uCCB4 \uC608\uC0B0\uC774 \uD3B8\uC131\uB41C \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uAD6C\uCCAD\uC740 \uC9C0\uD558 \uC2DC\uC124\uBB3C \uACF5\uC0AC\uB85C \uC778\uD574 \uC7AC\uD3EC\uC7A5\uC774 \uBD88\uAC00\uD53C\uD588\uB2E4\uACE0 \uD574\uBA85\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 0
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uBC18\uBCF5\uB41C \uACF5\uC0AC\uC5D0 \uB300\uD55C \uBE44\uD310\uC774 \uB098\uC624\uBA70 \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uB9CC\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uACF5\uAC1C \uC790\uB8CC\uB97C \uADFC\uAC70\uB85C \uD55C \uB0B4\uC6A9 \uC790\uCCB4\uB294 \uD655\uC778 \uAC00\uB2A5\uD588\uC9C0\uB9CC \uC81C\uBAA9\uC758 \uC624\uD0C8\uC790\uB85C \uC778\uD574 \uC6D0\uB798 \uAE30\uB300\uD560 \uC218 \uC788\uC5C8\uB358 \uC2E0\uB8B0\uB3C4 \uC0C1\uC2B9 \uD6A8\uACFC\uB294 \uC0AC\uB77C\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
