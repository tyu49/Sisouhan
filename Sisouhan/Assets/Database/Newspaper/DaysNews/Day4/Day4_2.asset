  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 14
  <ApprovedText>k__BackingField: "\uC0AC\uAC74\uACFC \uAD00\uACC4\uC5C6\uB294 \uAC00\uC871 \uACF5\uAC1C\uC640 \uC81C\uBAA9\uC758 \uC624\uD0C8\uC790\uAC00 \uACB9\uCE58\uBA70 \uC5B8\uB860\uC0AC\uC758 \uBCF4\uB3C4 \uD0DC\uB3C4\uC5D0 \uB300\uD55C \uBC18\uAC10\uC774 \uD06C\uAC8C \uB298\uC5C8\uC2B5\uB2C8\uB2E4."
