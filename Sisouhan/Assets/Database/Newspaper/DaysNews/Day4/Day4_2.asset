  <HeadLine>k__BackingField: "\uACF5\uAE30\uC5C5 \uC785\uCC30, \uD2B9\uC815 \uC5C5\uCCB4 \uD2B9\uD61C \uC758\uD639"
  <Text>k__BackingField: "\uC815\uBD80 \uC0B0\uD558 XX\uACF5\uC0AC\uC758 \uB0B4\uBD80 \uAC10\uC0AC\uC790\uB8CC\uC5D0 \uB530\uB974\uBA74 \uCD5C\uADFC \uB300\uD615 \uC2DC\uC124 \uBCF4\uC218\uACF5\uC0AC \uC785\uCC30\uC5D0\uC11C \uD2B9\uC815 \uC5C5\uCCB4\uC5D0 \uC720\uB9AC\uD55C \uC790\uACA9 \uC870\uAC74\uC774 \uBC18\uBCF5\uC801\uC73C\uB85C \uD3EC\uD568\uB41C \uC815\uD669\uC774 \uBC1C\uACAC\uB410\uC2B5\uB2C8\uB2E4. \uAC10\uC0AC\uD300\uC740 \uC77C\uBD80 \uC870\uAC74\uC774 \uACBD\uC7C1 \uC5C5\uCCB4\uC758 \uCC38\uC5EC\uB97C \uC5B4\uB835\uAC8C \uB9CC\uB4E4\uC5C8\uB2E4\uACE0 \uC9C0\uC801\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 11
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 8
  <ApprovedText>k__BackingField: "\uACF5\uAE30\uC5C5\uC758 \uC785\uCC30 \uACFC\uC815\uC774 \uACF5\uC815\uD558\uC9C0 \uC54A\uC558\uC744 \uC218 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uC54C\uB824\uC9C0\uBA70 \uC2DC\uBBFC\uB4E4\uC758 \uBC18\uBC1C\uC774 \uD06C\uAC8C \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uC678\uBD80\uC5D0 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC740 \uAC10\uC0AC \uB0B4\uC6A9\uC744 \uB2E4\uB8EC \uB2E8\uB3C5\uBCF4\uB3C4\uB77C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
