  <ManagingID>k__BackingField: day_4_6
  <AppearingDay>k__BackingField: 4
  <HeadLine>k__BackingField: "\uC300\uAC12 \uB450 \uBC30 \uD3ED\uB4F1\uC5D0\uB3C4 \uC815\uBD80\uB294 \uCE68\uBB35, \uBC25\uC0C1\uBB3C\uAC00 \uBE44\uC0C1"
  <Text>k__BackingField: "\uCD5C\uADFC \uD55C \uB2EC \uC0AC\uC774 \uC804\uAD6D \uD3C9\uADE0 \uC300\uAC12\uC774 \uB450 \uBC30 \uAC00\uAE4C\uC774 \uC62C\uB790\uC9C0\uB9CC \uC815\uBD80\uAC00 \uBCC4\uB2E4\uB978 \uB300\uCC45\uC744 \uB0B4\uB193\uC9C0 \uC54A\uACE0 \uC788\uB2E4\uB294 \uC8FC\uC7A5\uC774 \uC81C\uAE30\uB410\uC2B5\uB2C8\uB2E4. \uC77C\uBD80 \uC628\uB77C\uC778 \uAC8C\uC2DC\uAE00\uC5D0\uC11C\uB294 \uC0AC\uC7AC\uAE30\uC640 \uC720\uD1B5 \uC2E4\uD328\uAC00 \uC6D0\uC778\uC774\uB77C\uB294 \uC8FC\uC7A5\uB3C4 \uD655\uC0B0\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 8
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -10
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uAE09\uACA9\uD55C \uBB3C\uAC00 \uC0C1\uC2B9 \uC18C\uC2DD\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uB9CC\uC774 \uCEE4\uC9C0\uBA70 \uD601\uBA85\uB3C4\uB294 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC774\uD6C4 \uACF5\uAC1C\uB41C \uAC00\uACA9 \uD1B5\uACC4\uC5D0\uC11C \uC2E4\uC81C \uC0C1\uC2B9 \uD3ED\uC774 \uAE30\uC0AC \uB0B4\uC6A9\uACFC \uD06C\uAC8C \uB2EC\uB790\uB358 \uAC83\uC73C\uB85C \uD655\uC778\uB418\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
