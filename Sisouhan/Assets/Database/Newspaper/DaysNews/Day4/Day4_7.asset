  <ApprovedText>k__BackingField: "\uACF5\uACF5\uAE30\uAD00\uC758 \uC2E0\uC18D\uD55C \uB300\uC751\uC774 \uC54C\uB824\uC9C0\uBA70 \uC815\uBD80\uC640 \uACF5\uACF5\uAE30\uAD00\uC5D0 \uB300\uD55C \uAE0D\uC815\uC801\uC778 \uC5EC\uB860\uC774 \uB298\uC5B4 \uD601\uBA85\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4. \uC0AC\uC2E4\uAD00\uACC4\uB294 \uC815\uD655\uD588\uC9C0\uB9CC \uAE30\uC0AC\uC5D0 \uB208\uC5D0 \uB744\uB294 \uC624\uD0C8\uC790\uAC00 \uC788\uC5B4 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uAC00 \uB9CE\uC774 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
