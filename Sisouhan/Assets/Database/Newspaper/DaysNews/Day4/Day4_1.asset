  <ManagingID>k__BackingField: day_4_1
  <AppearingDay>k__BackingField: 4
  <HeadLine>k__BackingField: "\uCCAD\uB144 \uAD50\uD1B5\uBE44 \uBD80\uB2F4 \uC904\uC5B4\uB4E0\uB2E4, \uC815\uBD80 \uC9C0\uC6D0 \uB300\uC0C1 \uD655\uB300"
  <Text>k__BackingField: "\uC815\uBD80\uB294 \uB2E4\uC74C \uB2EC\uBD80\uD130 \uCCAD\uB144\uCE35\uC744 \uC911\uC2EC\uC73C\uB85C \uB300\uC911\uAD50\uD1B5\uBE44 \uC9C0\uC6D0 \uB300\uC0C1\uC744 \uD655\uB300\uD55C\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uC77C\uC815 \uC18C\uB4DD \uC774\uD558 \uCCAD\uB144\uC740 \uAE30\uC874 \uC9C0\uC6D0\uC5D0 \uB354\uD574 \uC6D4 \uAD50\uD1B5\uBE44 \uC77C\uBD80\uB97C \uCD94\uAC00\uB85C \uD658\uAE09\uBC1B\uC744 \uC218 \uC788\uC73C\uBA70 \uC138\uBD80 \uAE30\uC900\uC740 \uC774\uB2EC \uC911 \uACF5\uAC1C\uB420 \uC608\uC815\uC785\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -7
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uC0DD\uD65C\uBE44 \uBD80\uB2F4\uC744 \uC904\uC774\uB294 \uC815\uCC45\uC5D0 \uAE0D\uC815\uC801\uC778 \uBC18\uC751\uC774 \uC774\uC5B4\uC9C0\uBA74\uC11C \uC815\uBD80\uC5D0 \uB300\uD55C \uBD88\uB9CC\uC774 \uB2E4\uC18C \uC904\uC5C8\uC2B5\uB2C8\uB2E4. \uACF5\uAC1C\uB41C \uC815\uCC45\uC744 \uC815\uD655\uD558\uAC8C \uC804\uB2EC\uD574 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uC62C\uB790\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
