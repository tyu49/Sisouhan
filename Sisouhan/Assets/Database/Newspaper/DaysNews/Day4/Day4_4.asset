  <ManagingID>k__BackingField: day_4_4
  <AppearingDay>k__BackingField: 4
  <HeadLine>k__BackingField: "\uC9D1\uD68C\uC5D0 \uB098\uAC00\uBA74 \uAE30\uB85D\uB41C\uB2E4? \uACBD\uCC30, \uCC38\uAC00\uC790 \uC815\uBCF4\uC218\uC9D1 \uBC94\uC704 \uD655\uB300"
  <Text>k__BackingField: "\uACBD\uCC30 \uB0B4\uBD80 \uBCF4\uACE0\uC5D0 \uB530\uB974\uBA74 \uCD5C\uADFC \uC9D1\uD68C\uC640 \uC2DC\uC704 \uD604\uC7A5\uC5D0\uC11C \uCC38\uAC00\uC790\uC640 \uC8FC\uCD5C \uCE21\uC5D0 \uB300\uD55C \uC815\uBCF4 \uC218\uC9D1 \uBC94\uC704\uB97C \uAE30\uC874\uBCF4\uB2E4 \uD655\uB300\uD558\uB77C\uB294 \uC9C0\uCE68\uC774 \uB0B4\uB824\uAC04 \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uACBD\uCC30\uC740 \uACF5\uC2DD\uC801\uC73C\uB85C \uD574\uB2F9 \uC9C0\uCE68\uC758 \uC874\uC7AC\uB97C \uBC1D\uD788\uC9C0 \uC54A\uC740 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 12
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 10
  <ApprovedText>k__BackingField: "\uC9D1\uD68C \uCC38\uAC00\uC790\uC5D0 \uB300\uD55C \uC815\uBCF4 \uC218\uC9D1\uC774 \uD655\uB300\uB410\uB2E4\uB294 \uC18C\uC2DD\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uC548\uACFC \uBC18\uBC1C\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uACF5\uC2DD \uBC1C\uD45C \uC774\uC804\uC758 \uB0B4\uBD80 \uC815\uBCF4\uB97C \uB2E8\uB3C5\uC73C\uB85C \uBCF4\uB3C4\uD558\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
