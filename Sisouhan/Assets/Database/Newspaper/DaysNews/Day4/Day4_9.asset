  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 9
  <ApprovedText>k__BackingField: "\uC218\uC0AC\uAE30\uAD00\uC758 \uC815\uBCF4 \uAD00\uB9AC\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uCEE4\uC84C\uC9C0\uB9CC \uC81C\uBAA9\uC758 \uC624\uD0C8\uC790\uC640 \uBE44\uACF5\uAC1C \uC815\uBCF4 \uBCF4\uB3C4\uAC00 \uACB9\uCE58\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB3C4 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
