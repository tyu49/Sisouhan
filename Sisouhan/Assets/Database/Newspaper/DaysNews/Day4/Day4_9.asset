  <HeadLine>k__BackingField: "\uAC80\uCC30 \uC9C1\uC6D0, \uC815\uBCF4 \uC720\uCD9C\uB42C\uB2E4"
  <Text>k__BackingField: "\uAC80\uCC30 \uB0B4\uBD80 \uC870\uC0AC\uC5D0\uC11C \uC9C1\uC6D0 \uD55C \uBA85\uC774 \uC218\uC0AC \uC911\uC778 \uC0AC\uAC74\uC758 \uBE44\uACF5\uAC1C \uC815\uBCF4\uB97C \uC678\uBD80\uC5D0 \uC804\uB2EC\uD55C \uC815\uD669\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC720\uCD9C\uB41C \uC815\uBCF4\uC5D0\uB294 \uC0AC\uAC74 \uC9C4\uD589 \uC0C1\uD669\uACFC \uAD00\uB828\uC790\uC5D0 \uB300\uD55C \uB0B4\uBD80 \uAC80\uD1A0 \uB0B4\uC6A9 \uC77C\uBD80\uAC00 \uD3EC\uD568\uB41C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uAC80\uCC30\uC740 \uC804\uB2EC \uACBD\uC704\uC640 \uCD94\uAC00 \uC720\uCD9C \uC5EC\uBD80\uB97C \uC870\uC0AC \uC911\uC774\uBA70 \uC544\uC9C1 \uACF5\uC2DD \uBC1C\uD45C \uC804\uC785\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 10
  - <Effect>k__BackingField: 1
