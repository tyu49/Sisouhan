  <HeadLine>k__BackingField: "\uACBD\uCC30 \uACE0\uC704\uC9C1, \uC0AC\uAC74 \uAC1C\uC785 \uC758\uD639"
  <Text>k__BackingField: "\uACBD\uCC30 \uB0B4\uBD80 \uAC10\uCC30\uC5D0\uC11C \uACE0\uC704 \uAC04\uBD80\uAC00 \uD2B9\uC815 \uC0AC\uAC74 \uCC98\uB9AC \uACFC\uC815\uC5D0 \uBD80\uB2F9\uD55C \uC601\uD5A5\uB825\uC744 \uD589\uC0AC\uD55C \uC815\uD669\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC0AC\uAC74 \uB2F4\uB2F9\uC790\uC5D0\uAC8C \uCC98\uB9AC \uBC29\uD5A5\uC744 \uBC14\uAFB8\uB3C4\uB85D \uC694\uAD6C\uD588\uB2E4\uB294 \uB0B4\uBD80 \uC9C4\uC220\uB3C4 \uD655\uBCF4\uB41C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC73C\uBA70 \uAC10\uCC30\uD300\uC740 \uD574\uB2F9 \uC9C0\uC2DC\uAC00 \uC2E4\uC81C \uC218\uC0AC\uC5D0 \uC601\uD5A5\uC744 \uBBF8\uCCE4\uB294\uC9C0 \uD655\uC778 \uC911\uC785\uB2C8\uB2E4. \uAC10\uCC30 \uACB0\uACFC\uB294 \uC544\uC9C1 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 14
