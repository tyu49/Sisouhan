    <Value>k__BackingField: 13
  <ApprovedText>k__BackingField: "\uCE58\uC548\uC744 \uCC45\uC784\uC9C0\uB294 \uACE0\uC704\uC9C1\uC758 \uAC1C\uC785 \uC758\uD639\uC5D0 \uACBD\uCC30 \uC870\uC9C1 \uC804\uCCB4\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uD06C\uAC8C \uBC88\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
