  <ManagingID>k__BackingField: day_7_12
  <AppearingDay>k__BackingField: 7
  <HeadLine>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 L, \uBC18\uBCF5 \uBC94\uC8C4 \uBE44\uBC00\uC218\uC0AC"
  <Text>k__BackingField: "\uC218\uC0AC\uAE30\uAD00\uC774 \uD604\uC9C1 \uAD6D\uD68C\uC758\uC6D0 L\uC5D0\uAC8C \uC81C\uAE30\uB41C \uC5EC\uB7EC \uBC94\uC8C4 \uC758\uD639\uC744 \uBE44\uACF5\uAC1C\uB85C \uC870\uC0AC \uC911\uC778 \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC758\uD639\uC740 \uC11C\uB85C \uB2E4\uB978 \uC2DC\uAE30\uC5D0 \uBC1C\uC0DD\uD55C \uC5EC\uB7EC \uC0AC\uAC74\uACFC \uAD00\uB828\uB3FC \uC788\uC73C\uBA70 \uC77C\uBD80\uB294 \uACFC\uAC70\uC5D0\uB3C4 \uBB38\uC81C\uAC00 \uC81C\uAE30\uB410\uC9C0\uB9CC \uC815\uC2DD \uC218\uC0AC\uB85C \uC774\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB358 \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uD604\uC7AC \uC218\uC0AC \uC9C4\uD589 \uC0AC\uC2E4 \uC790\uCCB4\uAC00 \uC544\uC9C1 \uACF5\uC2DD \uBC1C\uD45C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 19
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -2
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 20
  <ApprovedText>k__BackingField: "\uD604\uC9C1 \uAD6D\uD68C\uC758\uC6D0\uC774 \uC5EC\uB7EC \uC758\uD639\uC73C\uB85C \uBE44\uBC00\uC218\uC0AC\uB97C \uBC1B\uACE0 \uC788\uB2E4\uB294 \uC18C\uC2DD\uC5D0 \uC815\uCE58\uAD8C\uC744 \uD5A5\uD55C \uBD84\uB178\uAC00 \uD06C\uAC8C \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uBE44\uACF5\uAC1C \uC218\uC0AC \uB0B4\uC6A9\uC744 \uB2E4\uB8EC \uB9CC\uD07C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uC18C\uD3ED \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
