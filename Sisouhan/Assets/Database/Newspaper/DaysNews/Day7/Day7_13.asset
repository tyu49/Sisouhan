  <ManagingID>k__BackingField: day_7_13
  <AppearingDay>k__BackingField: 7
  <HeadLine>k__BackingField: "\uC758\uC6D0 L, \uC218\uB144\uAC04 \uBC94\uC8C4 \uC758\uD639"
  <Text>k__BackingField: "\uBE44\uACF5\uAC1C \uC218\uC0AC\uC790\uB8CC\uC5D0\uC11C \uAD6D\uD68C\uC758\uC6D0 L\uC5D0\uAC8C \uC11C\uB85C \uB2E4\uB978 \uC2DC\uAE30\uC5D0 \uBC1C\uC0DD\uD55C \uC5EC\uB7EC \uBC94\uC8C4 \uC758\uD639\uC774 \uBC18\uBCF5\uC801\uC73C\uB85C \uC81C\uAE30\uB41C \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC790\uB8CC\uC5D0\uB294 \uAC01\uAC01 \uBCC4\uAC1C\uC758 \uC0AC\uAC74\uC73C\uB85C \uBCF4\uC600\uB358 \uC758\uD639 \uC0AC\uC774\uC5D0 \uACF5\uD1B5\uB41C \uAD00\uACC4\uC790\uAC00 \uB4F1\uC7A5\uD55C\uB2E4\uB294 \uB0B4\uC6A9\uB3C4 \uD3EC\uD568\uB41C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uC218\uC0AC\uAE30\uAD00\uC740 \uAD00\uB828\uC131\uC744 \uD655\uC778 \uC911\uC774\uBA70 \uC544\uC9C1 \uAD6C\uCCB4\uC801\uC778 \uB0B4\uC6A9\uC744 \uC678\uBD80\uC5D0 \uACF5\uAC1C\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 18
  - <Effect>k__BackingField: 1
