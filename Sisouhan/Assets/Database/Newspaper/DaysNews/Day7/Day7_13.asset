    <Value>k__BackingField: 18
  <ApprovedText>k__BackingField: "\uD55C \uBA85\uC758 \uD604\uC9C1 \uC815\uCE58\uC778\uC5D0\uAC8C \uC5EC\uB7EC \uC758\uD639\uC774 \uC774\uC5B4\uC84C\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uC54C\uB824\uC9C0\uBA70 \uC815\uBD80\uC640 \uC815\uCE58\uAD8C \uC804\uBC18\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uD06C\uAC8C \uD655\uC0B0\uB410\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
