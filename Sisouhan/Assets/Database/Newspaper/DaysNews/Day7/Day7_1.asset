  <ManagingID>k__BackingField: day_7_1
  <AppearingDay>k__BackingField: 7
  <HeadLine>k__BackingField: "\uACE0\uC704 \uACF5\uC9C1\uC790 K, \uAE08\uD488\uC218\uC218 \uC758\uD639"
  <Text>k__BackingField: "\uB0B4\uBD80 \uAC10\uCC30\uC790\uB8CC\uC5D0\uC11C \uACE0\uC704 \uACF5\uC9C1\uC790 K\uAC00 \uC5EC\uB7EC \uACF5\uACF5\uC0AC\uC5C5 \uAD00\uB828 \uC5C5\uCCB4\uB4E4\uB85C\uBD80\uD130 \uAE08\uD488\uACFC \uAC01\uC885 \uD3B8\uC758\uB97C \uC81C\uACF5\uBC1B\uC740 \uC815\uD669\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC77C\uBD80 \uC5C5\uCCB4\uB294 \uCD5C\uADFC \uC815\uBD80 \uC0AC\uC5C5\uC5D0 \uCC38\uC5EC\uD55C \uC774\uB825\uC774 \uC788\uC73C\uBA70 \uAC10\uCC30\uD300\uC740 \uC81C\uACF5\uB41C \uAE08\uD488\uACFC \uC0AC\uC5C5 \uC218\uC8FC \uC0AC\uC774\uC758 \uC5F0\uAD00\uC131\uC744 \uCD94\uAC00\uB85C \uD655\uC778 \uC911\uC778 \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uAC10\uCC30\uC740 \uC544\uC9C1 \uACF5\uC2DD \uBC1C\uD45C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 16
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -2
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 14
  <ApprovedText>k__BackingField: "\uACE0\uC704\uCE35\uACFC \uACF5\uACF5\uC0AC\uC5C5\uC758 \uC720\uCC29 \uC758\uD639\uC774 \uC54C\uB824\uC9C0\uBA70 \uC815\uBD80\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uAE09\uACA9\uD788 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uBE44\uACF5\uAC1C \uAC10\uCC30\uC744 \uB2E4\uB8EC \uB9CC\uD07C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uC18C\uD3ED \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
