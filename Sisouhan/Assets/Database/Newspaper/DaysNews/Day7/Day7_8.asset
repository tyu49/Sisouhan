  <ManagingID>k__BackingField: day_7_8
  <AppearingDay>k__BackingField: 7
  <HeadLine>k__BackingField: "\uACF5\uAE30\uC5C5 \uC0AC\uC7A5, \uCE5C\uC778\uCC99 \uCC44\uC6A9 \uB17C\uB780"
  <Text>k__BackingField: "\uACF5\uAE30\uC5C5 \uAC10\uC0AC \uACB0\uACFC \uC0AC\uC7A5 \uC7AC\uC784 \uAE30\uAC04 \uB3D9\uC548 \uAC00\uAE4C\uC6B4 \uC778\uC0AC\uC758 \uCC44\uC6A9 \uACFC\uC815\uC5D0 \uD2B9\uD61C\uC131 \uC808\uCC28\uAC00 \uC788\uC5C8\uB358 \uC0AC\uC2E4\uC774 \uACF5\uC2DD \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC77C\uBD80 \uC9C0\uC6D0\uC790\uB294 \uC77C\uBC18 \uC9C0\uC6D0\uC790\uC640 \uB2E4\uB978 \uBC29\uC2DD\uC73C\uB85C \uD3C9\uAC00\uB97C \uBC1B\uC558\uACE0 \uCC44\uC6A9 \uAE30\uC900\uB3C4 \uC911\uAC04\uC5D0 \uBCC0\uACBD\uB41C \uAC83\uC73C\uB85C \uC870\uC0AC\uB410\uC2B5\uB2C8\uB2E4. \uACF5\uAE30\uC5C5\uC740 \uAD00\uB828\uC790 \uC9D5\uACC4\uC640 \uCC44\uC6A9 \uC808\uCC28 \uAC1C\uC120\uC5D0 \uCC29\uC218\uD558\uACA0\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 10
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 1
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uACF5\uACF5\uAE30\uAD00\uC758 \uCC44\uC6A9 \uACF5\uC815\uC131\uC5D0 \uB300\uD55C \uBD84\uB178\uAC00 \uCEE4\uC9C0\uBA70 \uC815\uBD80 \uC0B0\uD558\uAE30\uAD00 \uC804\uBC18\uC5D0 \uB300\uD55C \uBE44\uD310\uC774 \uC774\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
