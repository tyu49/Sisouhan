  <HeadLine>k__BackingField: "\uBC94\uC8C4\uC870\uC9C1 \uC5F0\uB8E8 \uACF5\uC9C1\uC790 \uCD94\uAC00 \uC758\uD639"
  <Text>k__BackingField: "\uBE44\uACF5\uAC1C \uC218\uC0AC\uC790\uB8CC\uC5D0\uC11C \uBC94\uC8C4\uC870\uC9C1\uACFC \uBC18\uBCF5\uC801\uC73C\uB85C \uC811\uCD09\uD55C \uC815\uD669\uC774 \uC788\uB294 \uACF5\uC9C1\uC790\uAC00 \uCD94\uAC00\uB85C \uD655\uC778\uB41C \uAC83\uC73C\uB85C \uC804\uD574\uC84C\uC2B5\uB2C8\uB2E4. \uC218\uC0AC\uAE30\uAD00\uC740 \uD574\uB2F9 \uC778\uBB3C\uC774 \uB2E8\uC21C\uD788 \uAC1C\uC778\uC801\uC73C\uB85C \uC811\uCD09\uD55C \uAC83\uC778\uC9C0 \uC2E4\uC81C \uACF5\uACF5 \uC5C5\uBB34\uC5D0 \uC601\uD5A5\uC744 \uC92C\uB294\uC9C0\uB97C \uD655\uC778\uD558\uACE0 \uC788\uC73C\uBA70 \uAD00\uB828 \uAE30\uAD00 \uB0B4\uBD80 \uC790\uB8CC\uB3C4 \uD568\uAED8 \uAC80\uD1A0 \uC911\uC778 \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uD574\uB2F9 \uB0B4\uC6A9\uC740 \uACF5\uC2DD \uBC1C\uD45C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 17
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -2
