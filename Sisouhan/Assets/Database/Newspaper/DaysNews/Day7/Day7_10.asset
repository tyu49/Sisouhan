    <Value>k__BackingField: 18
  <ApprovedText>k__BackingField: "\uACF5\uC9C1\uC0AC\uD68C\uC640 \uBC94\uC8C4\uC870\uC9C1 \uC0AC\uC774\uC758 \uC5F0\uACB0 \uC758\uD639\uC774 \uD655\uC0B0\uB418\uBA70 \uC815\uBD80\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uB9E4\uC6B0 \uD06C\uAC8C \uB192\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
