  <ManagingID>k__BackingField: day_7_3
  <AppearingDay>k__BackingField: 7
  <HeadLine>k__BackingField: "\uC815\uBD80, \uBC18\uC815\uBD80 \uC5EC\uB860 \uB300\uC751 \uBE44\uBC00 \uAC80\uD1A0"
  <Text>k__BackingField: "\uC815\uBD80 \uB0B4\uBD80\uC5D0\uC11C \uCD5C\uADFC \uBE60\uB974\uAC8C \uD655\uC0B0\uB418\uB294 \uBC18\uC815\uBD80 \uC5EC\uB860\uC5D0 \uB300\uD55C \uB300\uC751 \uBC29\uC548\uC744 \uBE44\uACF5\uAC1C\uB85C \uAC80\uD1A0 \uC911\uC778 \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uB0B4\uBD80 \uBB38\uAC74\uC5D0\uB294 \uC628\uB77C\uC778 \uC5EC\uB860\uACFC \uB300\uADDC\uBAA8 \uC9D1\uD68C \uB3D9\uD5A5\uC744 \uC9C0\uC18D\uC801\uC73C\uB85C \uD30C\uC545\uD574\uC57C \uD55C\uB2E4\uB294 \uC758\uACAC\uC774 \uD3EC\uD568\uB41C \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uAD6C\uCCB4\uC801\uC778 \uB300\uC751 \uBC29\uC2DD\uC740 \uC544\uC9C1 \uACF5\uC2DD\uC801\uC73C\uB85C \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 17
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -2
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 16
  <ApprovedText>k__BackingField: "\uC815\uBD80\uAC00 \uC5EC\uB860 \uD655\uC0B0 \uC790\uCCB4\uB97C \uBB38\uC81C\uB85C \uBCF4\uACE0 \uC788\uB2E4\uB294 \uC778\uC2DD\uC774 \uD37C\uC9C0\uBA70 \uBC18\uBC1C\uC774 \uD06C\uAC8C \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uBE44\uACF5\uAC1C \uB0B4\uBD80 \uB0B4\uC6A9\uC744 \uB2E4\uB8EC \uBCF4\uB3C4\uB77C \uC2E0\uB8B0\uB3C4\uB294 \uC870\uAE08 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
