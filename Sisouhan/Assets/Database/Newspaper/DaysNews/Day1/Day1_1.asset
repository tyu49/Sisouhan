  <ApprovedText>k__BackingField: "\uC138\uB300\uBCC4\uB85C \uBC18\uC751\uC774 \uC5C7\uAC08\uB838\uC9C0\uB9CC \uACF5\uC2DD \uBC1C\uD45C \uB0B4\uC6A9\uC744 \uC815\uD655\uD558\uAC8C \uC804\uB2EC\uD558\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uC62C\uB790\uC2B5\uB2C8\uB2E4. \uC815\uBD80 \uC804\uCCB4\uC5D0 \uB300\uD55C \uC5EC\uB860 \uBCC0\uD654\uB294 \uD06C\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
