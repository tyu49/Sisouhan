  <HeadLine>k__BackingField: "\uC815\uBD80, \uBCF5\uC9C0\uC608\uC0B0 \uD655\uB300 \uC120\uC5B8"
  <Text>k__BackingField: "\uC815\uBD80\uB294 \uB0B4\uB144\uB3C4 \uBCF5\uC9C0 \uAD00\uB828 \uC608\uC0B0\uC744 \uD655\uB300\uD574 \uC800\uC18C\uB4DD\uCE35 \uC0DD\uD65C \uC9C0\uC6D0\uACFC \uC9C0\uC5ED \uBCF5\uC9C0\uC11C\uBE44\uC2A4\uC5D0 \uCD94\uAC00 \uC7AC\uC815\uC744 \uD22C\uC785\uD558\uACA0\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uC138\uBD80 \uC0AC\uC5C5\uBCC4 \uC608\uC0B0 \uADDC\uBAA8\uB294 \uCD94\uD6C4 \uACF5\uAC1C\uB420 \uC608\uC815\uC785\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -10
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uBCF5\uC9C0 \uD655\uB300 \uC18C\uC2DD\uC5D0 \uC815\uBD80\uB97C \uAE0D\uC815\uC801\uC73C\uB85C \uD3C9\uAC00\uD558\uB294 \uC2DC\uBBFC\uB4E4\uC774 \uB298\uBA74\uC11C \uD601\uBA85\uB3C4\uB294 \uD06C\uAC8C \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4. \uACF5\uC2DD \uBC1C\uD45C\uB97C \uC815\uD655\uD788 \uC804\uB2EC\uD574 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uC62C\uB790\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
