  <ManagingID>k__BackingField: day_1_5
  <AppearingDay>k__BackingField: 1
  <HeadLine>k__BackingField: "\uD0C8\uBAA8 \uCE58\uB8CC \uC9C0\uC6D0 \uC678\uBA74\uD55C \uC815\uBD80?"
  <Text>k__BackingField: "XX\uB300\uD559 \uC5F0\uAD6C\uC9C4\uC740 \uC2E4\uD5D8 \uB2E8\uACC4\uC758 \uD0C8\uBAA8 \uCE58\uB8CC \uD6C4\uBCF4\uBB3C\uC9C8\uC5D0\uC11C \uAE0D\uC815\uC801\uC778 \uACB0\uACFC\uAC00 \uB098\uC654\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uC5F0\uAD6C\uC9C4\uC740 \uC815\uBD80\uC5D0 \uCD94\uAC00 \uC5F0\uAD6C\uBE44\uB97C \uC694\uCCAD\uD588\uC9C0\uB9CC \uAE30\uC0AC\uC5D0\uC11C\uB294 \uC815\uBD80\uAC00 \uC544\uBB34\uB7F0 \uB2F5\uBCC0\uB3C4 \uD558\uC9C0 \uC54A\uC740 \uCC44 \uC5F0\uAD6C\uB97C \uC678\uBA74\uD558\uACE0 \uC788\uB2E4\uACE0 \uC804\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 10
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -15
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uC720\uB9DD\uD55C \uC5F0\uAD6C\uB97C \uC815\uBD80\uAC00 \uC678\uBA74\uD588\uB2E4\uB294 \uBCF4\uB3C4\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uB9CC\uC774 \uBE60\uB974\uAC8C \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uC774\uD6C4 \uC815\uBD80\uAC00 \uC774\uBBF8 \uC5F0\uAD6C\uBE44 \uC9C0\uC6D0 \uAC80\uD1A0\uC5D0 \uB4E4\uC5B4\uAC14\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uC54C\uB824\uC9C0\uBA74\uC11C \uC5B8\uB860\uC0AC\uC758 \uC815\uBCF4\uB825\uACFC \uC2E0\uB8B0\uB3C4\uB294 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
