  <HeadLine>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 XX, \uB0A8\uBAB0\uB798 \uC774\uC5B4\uC628 \uAE30\uBD80"
  <Text>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 XX\uAC00 \uACE0\uB4F1\uD559\uC0DD \uC2DC\uC808\uBD80\uD130 \uC790\uC2E0\uC758 \uC6A9\uB3C8 \uC77C\uBD80\uB97C \uAFB8\uC900\uD788 \uAE30\uBD80\uD574\uC654\uC73C\uBA70 \uAD6D\uD68C\uC758\uC6D0\uC774 \uB41C \uC774\uD6C4\uC5D0\uB3C4 \uAC1C\uC778\uC801\uC73C\uB85C \uAE30\uBD80\uB97C \uC774\uC5B4\uC628 \uC0AC\uC2E4\uC774 \uACF5\uAC1C\uB410\uC2B5\uB2C8\uB2E4. \uC758\uC6D0\uC740 \uC815\uCE58\uC801 \uD64D\uBCF4\uB85C \uBE44\uCE60 \uAC83\uC744 \uC6B0\uB824\uD574 \uC774\uB97C \uC801\uADF9\uC801\uC73C\uB85C \uC54C\uB9AC\uC9C0 \uC54A\uC558\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -15
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uC624\uB7AB\uB3D9\uC548 \uC774\uC5B4\uC9C4 \uAC1C\uC778 \uAE30\uBD80\uAC00 \uC54C\uB824\uC9C0\uBA70 \uD574\uB2F9 \uC758\uC6D0\uC744 \uAE0D\uC815\uC801\uC73C\uB85C \uD3C9\uAC00\uD558\uB294 \uC5EC\uB860\uC774 \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uACF5\uAC1C\uC801\uC73C\uB85C \uD655\uC778 \uAC00\uB2A5\uD55C \uB0B4\uC6A9\uC744 \uC815\uD655\uD788 \uBCF4\uB3C4\uD574 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB3C4 \uC0C1\uC2B9\uD588\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
