  <ApprovedText>k__BackingField: "\uC9D1\uD68C\uC758 \uC9C4\uD589 \uC0C1\uD669\uC744 \uBC95\uC5D0 \uC5B4\uAE0B\uB098\uC9C0 \uC54A\uAC8C \uC804\uB2EC\uD574 \uC815\uBD80 \uC815\uCC45\uC5D0 \uB300\uD55C \uBE44\uD310\uC740 \uC774\uC5B4\uC84C\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uC81C\uBAA9\uC758 \uB208\uC5D0 \uB744\uB294 \uC624\uD0C8\uC790\uB85C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
