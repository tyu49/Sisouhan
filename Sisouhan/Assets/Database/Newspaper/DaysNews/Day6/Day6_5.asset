  <HeadLine>k__BackingField: "\uC9D1\uD68C \uC885\uB8CC, \uCCA0\uD68C \uC694\uAD6C \uACC4\uC18D\uB400\uB2E4"
  <Text>k__BackingField: "XX\uAD11\uC7A5\uC5D0\uC11C \uC5F4\uB9B0 \uC9D1\uD68C\uAC00 \uD070 \uCDA9\uB3CC \uC5C6\uC774 \uB9C8\uBB34\uB9AC\uB410\uC2B5\uB2C8\uB2E4. \uC8FC\uCD5C \uCE21\uC740 \uC815\uBD80\uC758 \uC9D1\uD68C \uCC38\uAC00\uC790 \uC815\uBCF4 \uC218\uC9D1 \uC9C0\uCE68\uC774 \uCCA0\uD68C\uB420 \uB54C\uAE4C\uC9C0 \uD569\uBC95\uC801\uC778 \uBC29\uC2DD\uC73C\uB85C \uBB38\uC81C\uB97C \uC81C\uAE30\uD558\uACA0\uB2E4\uACE0 \uBC1D\uD614\uACE0 \uACBD\uCC30\uC740 \uD604\uC7A5\uC5D0\uC11C \uBCC4\uB2E4\uB978 \uC0AC\uACE0\uAC00 \uC5C6\uC5C8\uB2E4\uACE0 \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
