  <HeadLine>k__BackingField: "2\uB9CC \uBA85 \uBD80\uC871\uD558\uB2E4, \uAD11\uC7A5 \uCC44\uC6B0\uC790"
  <Text>k__BackingField: "XX\uAD11\uC7A5 \uC9D1\uD68C\uB97C \uC55E\uB450\uACE0 \uC8FC\uCD5C \uCE21\uC774 \uC57D 2\uB9CC \uBA85\uC758 \uCC38\uAC00\uC790\uB97C \uC608\uC0C1\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uAE30\uC0AC\uC5D0\uC11C\uB294 \uC774 \uADDC\uBAA8\uB85C\uB294 \uC815\uBD80\uAC00 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC744 \uAC83\uC774\uB77C\uBA70 \uB3C5\uC790\uB4E4\uC5D0\uAC8C \uAC00\uC871\uACFC \uC9C0\uC778\uAE4C\uC9C0 \uB370\uB9AC\uACE0 \uC9D1\uD68C\uC5D0 \uCC38\uC11D\uD558\uB77C\uACE0 \uC9C1\uC811 \uAD8C\uC720\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -8
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -10
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 12
  <ApprovedText>k__BackingField: "\uC5B8\uB860\uC0AC\uAC00 \uC9D1\uD68C\uC758 \uADDC\uBAA8\uB97C \uD0A4\uC6B0\uAE30 \uC704\uD574 \uC9C1\uC811 \uCC38\uAC00\uB97C \uB3C5\uB824\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uC54C\uB824\uC9C0\uBA70 \uBCF4\uB3C4\uAE30\uAD00\uC73C\uB85C\uC11C\uC758 \uC911\uB9BD\uC131\uC5D0 \uB300\uD55C \uC758\uBB38\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uC9D1\uD68C\uC758 \uBCF8\uB798 \uC8FC\uC7A5\uBCF4\uB2E4 \uC704\uBC95 \uB17C\uB780\uC774 \uB354 \uD06C\uAC8C \uBD80\uAC01\uB418\uBA74\uC11C \uD601\uBA85\uB3C4\uC640 \uC2E0\uB8B0\uB3C4\uAC00 \uBAA8\uB450 \uB0AE\uC544\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
