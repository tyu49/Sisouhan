  <ManagingID>k__BackingField: day_6_10
  <AppearingDay>k__BackingField: 6
  <HeadLine>k__BackingField: "\uACBD\uCC30 \uACE0\uC704\uAC04\uBD80, \uC5C5\uCCB4 \uAE08\uD488\uC218\uC218 \uC801\uBC1C"
  <Text>k__BackingField: "\uACBD\uCC30\uC740 \uB0B4\uBD80 \uAC10\uCC30 \uACB0\uACFC \uACE0\uC704 \uAC04\uBD80 \uD55C \uBA85\uC774 \uBBFC\uAC04\uC5C5\uCCB4 \uAD00\uACC4\uC790\uB85C\uBD80\uD130 \uAE08\uD488\uC744 \uBC1B\uC740 \uC0AC\uC2E4\uC744 \uD655\uC778\uD588\uB2E4\uACE0 \uACF5\uC2DD \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uAC10\uCC30 \uACFC\uC815\uC5D0\uC11C\uB294 \uC5EC\uB7EC \uCC28\uB840\uC5D0 \uAC78\uCCD0 \uBD80\uC801\uC808\uD55C \uC811\uCD09\uC774 \uC788\uC5C8\uB358 \uC815\uD669\uB3C4 \uD655\uC778\uB410\uC73C\uBA70 \uACBD\uCC30\uC740 \uB300\uAC00\uC131 \uC5EC\uBD80\uB97C \uCD94\uAC00 \uC870\uC0AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uAC04\uBD80\uB294 \uD604\uC7AC \uC9C1\uBB34\uC5D0\uC11C \uBC30\uC81C\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 9
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: 5
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uC218\uC0AC\uAE30\uAD00 \uACE0\uC704\uC9C1\uC758 \uAE08\uD488 \uBE44\uC704\uAC00 \uD655\uC778\uB418\uBA70 \uACBD\uCC30 \uC870\uC9C1 \uC804\uCCB4\uC5D0 \uB300\uD55C \uBE44\uD310\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uACF5\uC2DD \uAC10\uCC30 \uACB0\uACFC\uB97C \uADFC\uAC70\uB85C \uD55C \uBCF4\uB3C4\uB85C \uC2E0\uB8B0\uB3C4\uB294 \uC62C\uB790\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
