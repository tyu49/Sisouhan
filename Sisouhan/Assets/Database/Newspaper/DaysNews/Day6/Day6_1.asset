  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uD604\uC9C1 \uAD6D\uD68C\uC758\uC6D0\uC758 \uAE08\uD488\uC218\uC218 \uD610\uC758\uAC00 \uACF5\uC2DD\uC801\uC73C\uB85C \uD655\uC778\uB418\uBA74\uC11C \uC815\uCE58\uAD8C\uC5D0 \uB300\uD55C \uC2DC\uBBFC\uB4E4\uC758 \uBD88\uC2E0\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uB0B4\uC6A9\uC740 \uC815\uD655\uD588\uC9C0\uB9CC \uC81C\uBAA9\uC758 \uC624\uD0C8\uC790\uB85C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
