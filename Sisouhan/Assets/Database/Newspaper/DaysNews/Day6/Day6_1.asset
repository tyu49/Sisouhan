  <HeadLine>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 C \uAD6C\uC18D, \uC218\uC0AC \uD655\uB300\uB42C\uB2E4"
  <Text>k__BackingField: "\uAC80\uCC30\uC740 \uD604\uC9C1 \uAD6D\uD68C\uC758\uC6D0 C\uAC00 \uAC74\uC124\uC5C5\uCCB4\uB85C\uBD80\uD130 \uC5EC\uB7EC \uCC28\uB840 \uAE08\uD488\uC744 \uBC1B\uC740 \uD610\uC758\uB85C \uAD6C\uC18D\uB410\uB2E4\uACE0 \uACF5\uC2DD \uBC1C\uD45C\uD588\uC2B5\uB2C8\uB2E4. \uAC80\uCC30\uC740 \uD574\uB2F9 \uAE08\uD488\uC774 \uC758\uC815\uD65C\uB3D9\uACFC \uAD00\uB828\uB41C \uCCAD\uD0C1\uC758 \uB300\uAC00\uC600\uB294\uC9C0\uB97C \uCD94\uAC00\uB85C \uC870\uC0AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 8
  - <Effect>k__BackingField: 1
