  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 11
  <ApprovedText>k__BackingField: "\uBC94\uC8C4\uC640 \uAD00\uACC4\uC5C6\uB294 \uCE5C\uCC99\uC758 \uC2E0\uC0C1\uC744 \uACF5\uAC1C\uD55C \uB370 \uB300\uD55C \uBE44\uD310\uC774 \uBE60\uB974\uAC8C \uBC88\uC84C\uC2B5\uB2C8\uB2E4. \uAE30\uC0AC\uC5D0 \uB2F4\uAE34 \uBC94\uC8C4 \uC0AC\uC2E4\uAE4C\uC9C0 \uC120\uC815\uC801\uC778 \uBCF4\uB3C4\uC5D0 \uBB3B\uD788\uBA74\uC11C \uC815\uBD80\uC5D0 \uB300\uD55C \uBE44\uD310\uBCF4\uB2E4 \uC5B8\uB860\uC0AC\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
