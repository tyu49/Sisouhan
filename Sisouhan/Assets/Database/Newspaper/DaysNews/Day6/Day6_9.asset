  <HeadLine>k__BackingField: "\uD6A1\uB839 \uACFC\uC7A5 \uB3D9\uC0DD \uC2E4\uBA85\u00B7\uBD80\uC11C \uACF5\uAC1C"
  <Text>k__BackingField: "\uBCF5\uC9C0\uBCF4\uC870\uAE08 \uD6A1\uB839 \uD610\uC758\uB85C \uAE30\uC18C\uB41C XX\uC2DC \uACFC\uC7A5\uC758 \uB3D9\uC0DD\uC774 \uB2E4\uB978 \uACF5\uACF5\uAE30\uAD00\uC5D0\uC11C \uADFC\uBB34\uD558\uACE0 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uB3D9\uC0DD\uC740 \uBC94\uD589\uACFC \uC544\uBB34\uB7F0 \uAD00\uB828\uC774 \uC5C6\uC5C8\uC9C0\uB9CC \uAE30\uC0AC\uC5D0\uC11C\uB294 \uB3D9\uC0DD\uC758 \uC2E4\uBA85\uACFC \uADFC\uBB34 \uBD80\uC11C\uAE4C\uC9C0 \uACF5\uAC1C\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -7
  - <Effect>k__BackingField: 1
