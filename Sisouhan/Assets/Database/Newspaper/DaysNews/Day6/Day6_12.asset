  <HeadLine>k__BackingField: "\uC9D1\uD68C \uB05D\uB0AC\uC9C0\uB9CC \uB0B4\uC77C\uB3C4 \uAD11\uC7A5\uC73C\uB85C"
  <Text>k__BackingField: "\uC624\uB298 XX\uAD11\uC7A5\uC5D0\uC11C \uC5F4\uB9B0 \uC9D1\uD68C\uAC00 \uC885\uB8CC\uB41C \uB4A4 \uAE30\uC0AC\uC5D0\uC11C\uB294 \uC815\uBD80\uAC00 \uC815\uCC45\uC744 \uCCA0\uD68C\uD560 \uB54C\uAE4C\uC9C0 \uB9E4\uC77C \uC9D1\uD68C\uB97C \uC774\uC5B4\uAC00\uC57C \uD55C\uB2E4\uBA70 \uB3C5\uC790\uB4E4\uC5D0\uAC8C \uB2E4\uC74C \uB0A0 \uB2E4\uC2DC \uAD11\uC7A5\uC5D0 \uBAA8\uC77C \uAC83\uC744 \uC9C1\uC811 \uCD09\uAD6C\uD588\uC2B5\uB2C8\uB2E4."
