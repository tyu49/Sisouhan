  <ApprovedText>k__BackingField: "\uC9D1\uD68C \uACB0\uACFC\uB97C \uBCF4\uB3C4\uD558\uB294 \uC218\uC900\uC744 \uB118\uC5B4 \uB2E4\uC74C \uC9D1\uD68C \uCC38\uC5EC\uB97C \uC9C1\uC811 \uC694\uAD6C\uD588\uB2E4\uB294 \uBE44\uD310\uC774 \uC774\uC5B4\uC84C\uC2B5\uB2C8\uB2E4. \uC815\uBD80 \uC815\uCC45\uC5D0 \uB300\uD55C \uBE44\uD310\uBCF4\uB2E4 \uC5B8\uB860\uC0AC\uC758 \uC704\uBC95 \uD589\uC704\uAC00 \uB354 \uD070 \uB17C\uB780\uC774 \uB418\uBA74\uC11C \uD601\uBA85 \uC6B4\uB3D9\uC5D0 \uB300\uD55C \uC5EC\uB860\uAE4C\uC9C0 \uC545\uD654\uB410\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
