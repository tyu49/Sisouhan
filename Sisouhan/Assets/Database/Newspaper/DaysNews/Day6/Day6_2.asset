  <HeadLine>k__BackingField: "\uC804 XX\uBD80 \uC7A5\uAD00, 3\uC5B5 \uC6D0 \uC720\uC6A9 \uC720\uC8C4"
  <Text>k__BackingField: "\uBC95\uC6D0\uC740 \uC804 XX\uBD80 \uC7A5\uAD00 D\uAC00 \uC7AC\uC784 \uC911 \uBD80\uCC98 \uC608\uC0B0 \uC57D 3\uC5B5 \uC6D0\uC744 \uC0AC\uC801\uC778 \uC5EC\uD589\uACFC \uAC1C\uC778 \uBB3C\uD488 \uAD6C\uC785 \uB4F1\uC5D0 \uC0AC\uC6A9\uD55C \uD610\uC758\uB97C \uC778\uC815\uD574 \uC720\uC8C4\uB97C \uC120\uACE0\uD588\uC2B5\uB2C8\uB2E4. \uC7AC\uD310\uBD80\uB294 \uACF5\uC801 \uC790\uAE08\uC744 \uBC18\uBCF5\uC801\uC73C\uB85C \uC0AC\uC801\uC73C\uB85C \uC0AC\uC6A9\uD55C \uCC45\uC784\uC774 \uBB34\uAC81\uB2E4\uACE0 \uD310\uB2E8\uD588\uC2B5\uB2C8\uB2E4."
