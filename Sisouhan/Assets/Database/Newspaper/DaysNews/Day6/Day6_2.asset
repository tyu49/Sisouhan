  <ManagingID>k__BackingField: day_6_2
  <AppearingDay>k__BackingField: 6
  <HeadLine>k__BackingField: "\uC815\uBD80, \uBC94\uC8C4\uC870\uC9C1 \uBE44\uBC00\uC218\uC0AC \uC228\uACBC\uB098"
  <Text>k__BackingField: "\uC5EC\uB7EC \uC218\uC0AC\uAE30\uAD00\uC774 \uB300\uD615 \uBC94\uC8C4\uC870\uC9C1\uC744 \uB300\uC0C1\uC73C\uB85C \uBE44\uACF5\uAC1C \uD569\uB3D9\uC218\uC0AC\uB97C \uC774\uC5B4\uAC00\uACE0 \uC788\uB2E4\uB294 \uB0B4\uBD80 \uC815\uBCF4\uAC00 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC218\uC0AC\uB294 \uC7A5\uAE30\uAC04 \uC9C4\uD589\uB3FC \uC654\uC73C\uBA70 \uAD00\uB828 \uAE30\uAD00 \uC0AC\uC774\uC5D0\uC11C \uC0AC\uAC74 \uC790\uB8CC\uC640 \uAD00\uACC4\uC790 \uC815\uBCF4\uAC00 \uACF5\uC720\uB418\uACE0 \uC788\uB294 \uAC83\uC73C\uB85C \uC804\uD574\uC84C\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uC218\uC0AC \uC9C4\uD589 \uC0AC\uC2E4 \uC790\uCCB4\uAC00 \uC678\uBD80\uC5D0\uB294 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC740 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 13
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -8
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 15
  <ApprovedText>k__BackingField: "\uC815\uBD80\uC640 \uC218\uC0AC\uAE30\uAD00\uC774 \uC911\uC694\uD55C \uC0AC\uAC74\uC744 \uC228\uAE30\uACE0 \uC788\uB2E4\uB294 \uC778\uC2DD\uC774 \uD37C\uC9C0\uBA70 \uBD88\uC2E0\uC774 \uD06C\uAC8C \uB298\uC5C8\uC2B5\uB2C8\uB2E4. \uBE44\uACF5\uAC1C \uC218\uC0AC\uC815\uBCF4\uB97C \uB2E4\uB8EC \uBCF4\uB3C4\uB77C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uD558\uB77D\uD588\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
