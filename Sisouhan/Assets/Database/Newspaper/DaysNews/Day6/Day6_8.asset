  <HeadLine>k__BackingField: "\uC7A5\uAD00 \uCE21\uADFC, \uCC44\uC6A9 \uCCAD\uD0C1 \uB4DC\uB7EC\uB0AB\uB2E4"
  <Text>k__BackingField: "XX\uBD80 \uC7A5\uAD00\uC758 \uCE21\uADFC\uC774 \uACF5\uAE30\uC5C5 \uCC44\uC6A9 \uACFC\uC815\uC5D0 \uBD80\uB2F9\uD55C \uCCAD\uD0C1\uC744 \uD588\uB2E4\uB294 \uAC10\uC0AC \uACB0\uACFC\uAC00 \uACF5\uC2DD \uBC1C\uD45C\uB410\uC2B5\uB2C8\uB2E4. \uD574\uB2F9 \uACF5\uAE30\uC5C5\uC740 \uAD00\uB828 \uCC44\uC6A9 \uC808\uCC28\uB97C \uB2E4\uC2DC \uAC80\uD1A0\uD558\uACA0\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
