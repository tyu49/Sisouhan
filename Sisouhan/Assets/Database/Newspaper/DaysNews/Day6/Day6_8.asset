  <HeadLine>k__BackingField: "\uC804 \uC7A5\uAD00 D \uBC30\uC6B0\uC790\u00B7\uC790\uB140 \uC2E0\uC0C1 \uACF5\uAC1C"
  <Text>k__BackingField: "\uACF5\uAE08 \uC720\uC6A9\uC73C\uB85C \uC720\uC8C4 \uD310\uACB0\uC744 \uBC1B\uC740 \uC804 XX\uBD80 \uC7A5\uAD00 D\uC758 \uBC30\uC6B0\uC790\uC640 \uC131\uC778 \uC790\uB140\uC758 \uC774\uB984\uACFC \uC9C1\uC5C5\uC774 \uD568\uAED8 \uACF5\uAC1C\uB410\uC2B5\uB2C8\uB2E4. \uC218\uC0AC\uC640 \uC7AC\uD310\uC5D0\uC11C\uB294 \uC774\uB4E4\uC774 \uC7A5\uAD00\uC758 \uBC94\uC8C4\uC5D0 \uAD00\uC5EC\uD55C \uC0AC\uC2E4\uC774 \uC5C6\uB294 \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
