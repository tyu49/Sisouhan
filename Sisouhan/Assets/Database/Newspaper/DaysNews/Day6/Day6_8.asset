  <ApprovedText>k__BackingField: "\uC0AC\uAC74\uACFC \uBB34\uAD00\uD55C \uAC00\uC871\uAE4C\uC9C0 \uAE30\uC0AC\uC5D0 \uB04C\uC5B4\uB4E4\uC600\uB2E4\uB294 \uBE44\uD310\uC774 \uCEE4\uC9C0\uBA70 \uBCF4\uB3C4\uC758 \uC815\uB2F9\uC131\uC774 \uD754\uB4E4\uB838\uC2B5\uB2C8\uB2E4. \uC815\uBD80\uC758 \uBE44\uB9AC\uB97C \uBE44\uD310\uD558\uB824\uB358 \uAE30\uC0AC\uC600\uC9C0\uB9CC \uC624\uD788\uB824 \uC5B8\uB860\uC0AC\uC5D0 \uB300\uD55C \uBC18\uAC10\uC774 \uCEE4\uC9C0\uBA74\uC11C \uD601\uBA85\uB3C4\uC640 \uC2E0\uB8B0\uB3C4\uAC00 \uBAA8\uB450 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
