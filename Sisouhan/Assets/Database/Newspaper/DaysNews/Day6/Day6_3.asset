  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 0
  <ApprovedText>k__BackingField: "\uC815\uBD80\uC758 \uC815\uBCF4 \uC218\uC9D1 \uC815\uCC45\uC5D0 \uBC18\uB300\uD558\uB294 \uC5EC\uB860\uC774 \uB110\uB9AC \uC54C\uB824\uC9C0\uBA70 \uC2DC\uBBFC\uB4E4\uC758 \uAD00\uC2EC\uC774 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uC9D1\uD68C \uC0AC\uC2E4\uACFC \uC8FC\uC7A5\uC744 \uC804\uB2EC\uD558\uB294 \uB370 \uADF8\uCCD0 \uBC95\uC801 \uB17C\uB780 \uC5C6\uC774 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB3C4 \uC62C\uB790\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
