  <HeadLine>k__BackingField: "XX\uAD11\uC7A5 \uC9D1\uD68C, \uC815\uBCF4\uC218\uC9D1 \uC911\uB2E8 \uC694\uAD6C"
  <Text>k__BackingField: "\uC815\uBD80\uC758 \uC9D1\uD68C \uCC38\uAC00\uC790 \uC815\uBCF4 \uC218\uC9D1 \uD655\uB300\uC5D0 \uBC18\uB300\uD558\uB294 \uC9D1\uD68C\uAC00 \uC624\uB298 \uC624\uD6C4 XX\uAD11\uC7A5\uC5D0\uC11C \uC5F4\uB9B4 \uC608\uC815\uC785\uB2C8\uB2E4. \uC8FC\uCD5C \uCE21\uC740 \uC57D 2\uB9CC \uBA85\uC774 \uCC38\uAC00\uD560 \uAC83\uC73C\uB85C \uC608\uC0C1\uD588\uC73C\uBA70 \uACBD\uCC30\uC740 \uC9D1\uD68C \uC8FC\uBCC0 \uAD50\uD1B5 \uD1B5\uC81C\uB97C \uC900\uBE44\uD558\uACE0 \uC788\uB2E4\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: 7
  - <Effect>k__BackingField: 1
