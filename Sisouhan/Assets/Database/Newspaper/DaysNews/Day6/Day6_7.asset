  <HeadLine>k__BackingField: "\uD22C\uC790\uC0AC\uAE30 \uD575\uC2EC \uC6A9\uC758\uC790 \uD55C\uB2EC\uC9F8 \uB193\uCCD0"
  <Text>k__BackingField: "\uB300\uADDC\uBAA8 \uD22C\uC790\uC0AC\uAE30 \uC0AC\uAC74\uC5D0\uC11C \uACBD\uCC30\uC774 \uD575\uC2EC \uC6A9\uC758\uC790\uB97C \uD2B9\uC815\uD558\uACE0\uB3C4 \uD55C \uB2EC \uB118\uAC8C \uAC80\uAC70\uD558\uC9C0 \uBABB\uD55C \uC0AC\uC2E4\uC774 \uB0B4\uBD80 \uBCF4\uACE0\uC5D0\uC11C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC218\uC0AC \uC9C0\uC5F0 \uC0AC\uC2E4\uC740 \uC544\uC9C1 \uACF5\uAC1C\uB418\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
