  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 12
  <ApprovedText>k__BackingField: "\uBC94\uC8C4\uC640 \uAD00\uACC4\uC5C6\uB294 \uAC00\uC871\uC758 \uC2E0\uC0C1\uAE4C\uC9C0 \uACF5\uAC1C\uD55C \uBCF4\uB3C4\uC5D0 \uC9C0\uB098\uCE5C \uD3ED\uB85C\uB77C\uB294 \uBE44\uD310\uC774 \uC3DF\uC544\uC84C\uC2B5\uB2C8\uB2E4. \uC2DC\uBBFC\uB4E4\uC774 \uC5B8\uB860\uC0AC\uC758 \uBCF4\uB3C4 \uD0DC\uB3C4\uB97C \uBB38\uC81C \uC0BC\uC73C\uBA74\uC11C \uC815\uBD80 \uBE44\uD310 \uC5EC\uB860\uAE4C\uC9C0 \uC57D\uD574\uC84C\uACE0 \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB3C4 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
