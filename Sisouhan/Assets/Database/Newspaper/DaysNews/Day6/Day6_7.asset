  <ApprovedText>k__BackingField: "\uB300\uADDC\uBAA8 \uD53C\uD574\uAC00 \uBC1C\uC0DD\uD588\uB294\uB370\uB3C4 \uD575\uC2EC \uC6A9\uC758\uC790\uB97C \uC7A5\uAE30\uAC04 \uC7A1\uC9C0 \uBABB\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uACBD\uCC30\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774 \uD06C\uAC8C \uCEE4\uC84C\uC2B5\uB2C8\uB2E4. \uB0B4\uBD80 \uC218\uC0AC\uC815\uBCF4\uB97C \uB2E4\uB8EC \uBCF4\uB3C4\uB77C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uD558\uB77D\uD588\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
