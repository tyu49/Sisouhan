  <HeadLine>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 C \uCE5C\uD615, XX\uAC74\uC124 \uB300\uD45C"
  <Text>k__BackingField: "\uAE08\uD488\uC218\uC218 \uD610\uC758\uB85C \uAD6C\uC18D\uB41C \uAD6D\uD68C\uC758\uC6D0 C\uC758 \uCE5C\uD615\uC774 \uAC74\uC124\uC5C5\uC5D0 \uC885\uC0AC\uD558\uACE0 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uCE5C\uD615\uC740 \uC774\uBC88 \uC0AC\uAC74\uACFC \uAD00\uB828\uC774 \uC5C6\uB294 \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC9C0\uB9CC \uAE30\uC0AC\uC5D0\uC11C\uB294 \uCE5C\uD615\uC758 \uC2E4\uBA85\uACFC \uC9C1\uC7A5\uAE4C\uC9C0 \uD568\uAED8 \uACF5\uAC1C\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -8
  - <Effect>k__BackingField: 1
