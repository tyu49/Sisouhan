  <HeadLine>k__BackingField: "\uBCF5\uC9C0\uBCF4\uC870\uAE08 \uD6A1\uB839 \uACFC\uC7A5 \uAE30\uC18C"
  <Text>k__BackingField: "\uAC80\uCC30\uC740 XX\uC2DC \uBCF5\uC9C0\uC9C0\uC6D0\uACFC\uC7A5\uC774 \uBCF5\uC9C0\uC0AC\uC5C5 \uBCF4\uC870\uAE08 \uC77C\uBD80\uB97C \uAC1C\uC778 \uACC4\uC88C\uB85C \uBE7C\uB3CC\uB9B0 \uD610\uC758\uB85C \uAE30\uC18C\uB410\uB2E4\uACE0 \uBC1D\uD613\uC2B5\uB2C8\uB2E4. \uC2DC\uCCAD\uC740 \uD574\uB2F9 \uACFC\uC7A5\uC744 \uC9C1\uC704\uD574\uC81C\uD558\uACE0 \uD53C\uD574 \uAE08\uC561 \uD658\uC218 \uC808\uCC28\uC5D0 \uCC29\uC218\uD588\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
