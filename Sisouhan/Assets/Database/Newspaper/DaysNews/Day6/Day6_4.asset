  <ApprovedText>k__BackingField: "\uBCF5\uC9C0\uC608\uC0B0\uC744 \uB2F4\uB2F9\uD558\uB358 \uACF5\uBB34\uC6D0\uC758 \uBC94\uC8C4\uC5D0 \uC2DC\uBBFC\uB4E4\uC758 \uBE44\uD310\uC774 \uC774\uC5B4\uC84C\uC2B5\uB2C8\uB2E4. \uBC95\uC744 \uC9C0\uD0A4\uBA70 \uC0AC\uAC74\uACFC \uBB34\uAD00\uD55C \uAC00\uC871 \uC815\uBCF4\uB3C4 \uBC30\uC81C\uD588\uC9C0\uB9CC \uBCF8\uBB38\uC758 \uC624\uD0C8\uC790\uB85C \uC5B8\uB860\uC0AC\uC758 \uC2E0\uB8B0\uB3C4\uB294 \uB5A8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
