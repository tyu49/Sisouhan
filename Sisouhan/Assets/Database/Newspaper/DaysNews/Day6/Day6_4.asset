  <HeadLine>k__BackingField: "\uBE44\uACF5\uAC1C \uD569\uB3D9\uC218\uC0AC, \uC815\uBD80\uB294 \uCE68\uBB35"
  <Text>k__BackingField: "\uC218\uC0AC\uAE30\uAD00 \uC5EC\uB7EC \uACF3\uC774 \uBC94\uC8C4\uC870\uC9C1\uACFC \uAD00\uB828\uD55C \uD569\uB3D9\uC218\uC0AC\uB97C \uBE44\uACF5\uAC1C\uB85C \uC9C4\uD589\uD558\uACE0 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uC815\uBD80\uC640 \uC218\uC0AC\uAE30\uAD00\uC740 \uC544\uC9C1 \uACF5\uC2DD \uC785\uC7A5\uC744 \uB0B4\uB193\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
