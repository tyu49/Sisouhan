  <ManagingID>k__BackingField: day_6_14
  <AppearingDay>k__BackingField: 6
  <HeadLine>k__BackingField: "XX\uAD11\uC7A5 \uC9D1\uD68C, \uCC38\uAC00 \uC9C1\uC811 \uAD8C\uC720"
  <Text>k__BackingField: "\uC815\uBD80 \uBE44\uB9AC \uC218\uC0AC\uB97C \uCD09\uAD6C\uD558\uB294 \uC9D1\uD68C\uC758 \uAC1C\uCD5C \uC2DC\uAC04\uACFC \uC7A5\uC18C, \uC8FC\uCD5C \uCE21\uC758 \uC694\uAD6C\uC0AC\uD56D\uC774 \uAE30\uC0AC\uC5D0 \uC18C\uAC1C\uB410\uC2B5\uB2C8\uB2E4. \uAE30\uC0AC\uC5D0\uC11C\uB294 \uCD5C\uADFC \uC774\uC5B4\uC9C4 \uACF5\uC9C1 \uBE44\uB9AC \uC0AC\uAC74\uC744 \uD568\uAED8 \uC5B8\uAE09\uD558\uBA70 \uC9D1\uD68C \uBC30\uACBD\uC744 \uC124\uBA85\uD588\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uAE30\uC0AC \uB9D0\uBBF8\uC5D0\uB294 \uB3C5\uC790\uB4E4\uC5D0\uAC8C \uD574\uB2F9 \uC9D1\uD68C\uC5D0 \uC9C1\uC811 \uCC38\uAC00\uD560 \uAC83\uC744 \uAD8C\uC720\uD558\uB294 \uBB38\uAD6C\uAC00 \uD3EC\uD568\uB410\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -8
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -12
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 13
  <ApprovedText>k__BackingField: "\uC5B8\uB860\uC774 \uC9D1\uD68C \uC18C\uC2DD\uC744 \uC804\uB2EC\uD558\uB294 \uC218\uC900\uC744 \uB118\uC5B4 \uC9C1\uC811 \uCC38\uAC00\uB97C \uAD8C\uC720\uD588\uB2E4\uB294 \uBE44\uD310\uC774 \uC774\uC5B4\uC84C\uC2B5\uB2C8\uB2E4. \uC815\uBD80 \uBE44\uD310 \uC5EC\uB860\uBCF4\uB2E4 \uC5B8\uB860\uC0AC\uC758 \uD589\uB3D9\uC774 \uB354 \uD070 \uB17C\uB780\uC774 \uB410\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
