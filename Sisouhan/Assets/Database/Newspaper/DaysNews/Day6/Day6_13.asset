  <HeadLine>k__BackingField: "\uAD6D\uD68C\uC758\uC6D0 J \uAC00\uC871 \uC2E0\uC0C1\uAE4C\uC9C0 \uACF5\uAC1C"
  <Text>k__BackingField: "\uAE08\uD488 \uC758\uD639\uC744 \uBC1B\uB294 \uAD6D\uD68C\uC758\uC6D0 J\uC758 \uAC00\uC871\uC740 \uB0B4\uBD80 \uAC10\uCC30\uACFC \uC218\uC0AC \uACFC\uC815\uC5D0\uC11C \uC0AC\uAC74\uC5D0 \uAD00\uC5EC\uD55C \uC815\uD669\uC774 \uC5C6\uB294 \uAC83\uC73C\uB85C \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4. \uAC00\uC871\uB4E4\uC740 \uACF5\uACF5\uC0AC\uC5C5 \uC5C5\uCCB4\uC640\uB3C4 \uC9C1\uC811\uC801\uC778 \uAD00\uACC4\uAC00 \uC5C6\uB294 \uAC83\uC73C\uB85C \uC54C\uB824\uC84C\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uAE30\uC0AC\uC5D0\uB294 \uC0AC\uAC74\uACFC \uBB34\uAD00\uD55C \uCE5C\uC778\uCC99\uC758 \uC2E0\uC0C1\uC815\uBCF4\uAC00 \uD568\uAED8 \uC2E4\uB838\uC2B5\uB2C8\uB2E4."
  <EffectEntryList>k__BackingField:
  - <Effect>k__BackingField: 0
    <Value>k__BackingField: -9
  - <Effect>k__BackingField: 1
    <Value>k__BackingField: -14
  - <Effect>k__BackingField: 2
    <Value>k__BackingField: 13
  <ApprovedText>k__BackingField: "\uBC94\uC8C4 \uC758\uD639\uACFC \uAD00\uACC4\uC5C6\uB294 \uAC00\uC871\uAE4C\uC9C0 \uACF5\uAC1C\uD588\uB2E4\uB294 \uBE44\uD310\uC774 \uCEE4\uC9C0\uBA70 \uAE30\uC0AC \uC790\uCCB4\uC758 \uC815\uB2F9\uC131\uC774 \uD754\uB4E4\uB838\uC2B5\uB2C8\uB2E4. \uC815\uBD80 \uBE44\uD310\uBCF4\uB2E4 \uC5B8\uB860\uC0AC\uC758 \uBCF4\uB3C4 \uBC29\uC2DD\uC5D0 \uB300\uD55C \uBC18\uAC10\uC774 \uB354 \uCEE4\uC84C\uC2B5\uB2C8\uB2E4."
  <Propensity>k__BackingField: 0
